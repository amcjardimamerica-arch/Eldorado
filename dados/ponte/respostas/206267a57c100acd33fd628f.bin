        <form id="_br_com_seatecnologia_in_buscadou_BuscaDouPortlet_userDataForm" onsubmit="event.preventDefault();doSearch('advancedSearch');">
            <div id="div-search-bar" class="header">
                <div class="form-group">
                    <div class="input-group">
                    	<label for="search-bar" class="d-none">Busca</label>
                        <input value="chamamento público organizações da sociedade civil" type="text" name="search-bar" id="search-bar" class="form-control" placeholder="Informe o termo que deseja pesquisar nas Edi&ccedil;&otilde;es do Di&aacute;rio Oficial">
						<div class="input-group-addon"><i class="glyphicon glyphicon-search"><span class="d-none">&Iacute;cone</span></i> &nbsp;&nbsp; | &nbsp;&nbsp; <a id="toggle-search-advanced" role="button" href="javascript:void(0);">PESQUISA AVAN&Ccedil;ADA <i class="icon-chevron-sign-down"><span class="d-none">&Iacute;cone</span></i></a></div>
