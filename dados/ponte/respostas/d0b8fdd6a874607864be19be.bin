          <input type="hidden" name="erro" value="erro3" />
          <input type="hidden" name="erro" value="erro4" />
          <input type="hidden" name="erro" value="erro5" />
          <input class="d-none" id="formReportButton" type="submit" value="Enviar" />
        </form>
