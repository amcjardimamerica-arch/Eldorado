                </span>
              </label>
            </div>
            <div class="custom-control custom-checkbox">
              <label>
                <input required class="custom-control-input checkboxes" type="checkbox" id="erro5" name="erro" value="erro5"/>
                <span class="custom-control-label">
                  <span class="custom-control-label-text">Outros</span>
                </span>
              </label>
            </div>
          </div>
