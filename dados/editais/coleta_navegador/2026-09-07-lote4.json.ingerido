{
  "22ca6714458b99faf7a9": {
    "objeto": "CHAMAMENTO PUBLICO PARA QUALIFICACAO DE PESSOAS JURIDICAS DE DIREITO PRIVADO, SEM FINS LUCRATIVOS, COMO ORGANIZACAO SOCIAL DE SAUDE - OSS, no Municipio de Porangatu/GO (Edital no 001/2026, Procedimento Licitatorio no 2196/2026).",
    "inicio": null,
    "fim": null,
    "pagina_oficial": "https://acessoainformacao.porangatu.go.gov.br/cidadao/informacao/licitacoes_mg",
    "observacao": "PRAZO NAO LOCALIZADO NA FONTE OFICIAL - E NAO FOI ESTIMADO. O portal de licitacoes do municipio (Portal do Cidadao, atualizado em 04/09/2026) carrega a tabela por filtro dinamico e devolveu 'Nenhum resultado encontrado' na consulta padrao; a busca do site institucional (porangatu.go.gov.br) por 'chamamento' e por 'organizacao social' nao retorna este edital. CONTEXTO CONFIRMADO: a Camara Municipal debateu em marco/2026 a gestao por OSS do Hospital Municipal Henrique Santillo, o que da coerencia ao chamamento. TIPO DE OPORTUNIDADE: qualificacao previa como OSS de saude - so interessa a entidade com atuacao em saude e requisitos legais proprios. PENDENTE DE DECISAO DO TITULAR: pedir o edital pelo e-SIC do municipio se houver interesse em qualificacao como OSS."
  },
  "77be3a1f9404f5b292f0": {
    "objeto": "Celebracao de Termo de Colaboracao com Organizacao da Sociedade Civil (OSC) para execucao de projeto de investimento destinado a construcao, no Municipio de FORMOSA/GO.",
    "inicio": null,
    "fim": null,
    "pagina_oficial": "https://acessoainformacao.formosa.go.gov.br/cidadao/informacao/mp/id=28",
    "observacao": "PAGINA OFICIAL LOCALIZADA: mural de Chamamento Publico da Prefeitura de Formosa/GO (atualizado em 07/09/2026). Este edital especifico NAO aparece no mural; o prazo NAO foi localizado e NAO FOI ESTIMADO. ACHADO COLATERAL RELEVANTE PARA GOIAS - chamamentos de Formosa listados na fonte oficial: (a) 002/2026 SEAGRI, Programa de Aquisicao de Alimentos - PAA, abertura 02/09/2026; (b) 001/2026 CMDCA/FMSCA, 'selecionar projetos apresentados por Organizacoes da Sociedade Civil - OSCs regularmente constituidas, sem fins lucrativos', abertura 20/08/2026; (c) 001/2026 SEAGRI, termo de cessao de uso com OSCs e agricultores familiares, abertura 08/06/2026; (d) 001/2026 CMDI - Conselho Municipal dos Direitos do Idoso, abertura 08/05/2026. Formosa tambem mantem pagina propria de Editais Aldir Blanc. CADASTRAR FORMOSA COMO MUNICIPIO-SENSOR."
  },
  "f55515b0dd2abb47203c": {
    "objeto": "Selecao de propostas apresentadas pelas Organizacoes da Sociedade Civil de PLANALTINA/GO que visem a execucao de projetos em regime de mutua cooperacao com o Municipio (Credenciamento/Chamamento no 09/2024).",
    "inicio": null,
    "fim": null,
    "pagina_oficial": "https://acessoainformacao.planaltina.go.gov.br/cidadao/informacao/licitacoes_mg",
    "observacao": "PAGINA OFICIAL LOCALIZADA E ACESSIVEL (Portal do Cidadao da Prefeitura de Planaltina/GO). O anuncio de origem estava no Portal de Compras Publicas, que e plataforma-vetor, nao fonte oficial. EDITAL DE 2024, presumidamente exaurido; o prazo nao consta na fonte oficial e NAO FOI ESTIMADO. Planaltina/GO integra o Entorno do Distrito Federal - territorio de interesse. Objeto e do tipo diretamente aproveitavel por OSC: cadastrar como municipio-sensor para as proximas edicoes."
  },
  "c622d55b7caeca1b8147": {
