{
  "0eac700d7cb170ff96b1": {
    "objeto": "Edital Continuo de Apoio do Instituto Impactarte: selecionar e apoiar organizacoes da sociedade civil que demonstrem atuacao relevante e potencial transformador em diversas areas de impacto social. Apoio financeiro de ate R$ 150.000,00 por projeto ou programa, conforme plano de trabalho aprovado, mais articulacao em rede. Sem restricao de area tematica nem de natureza das despesas.",
    "inicio": null, "fim": null,
    "pagina_oficial": "https://www.impactarte.org.br/",
    "observacao": "ABERTO EM FLUXO CONTINUO. O regulamento oficial diz textualmente: 'O edital opera em fluxo continuo, sem prazo fixo de encerramento, permitindo que organizacoes se candidatem a qualquer momento' - por isso inicio e fim ficam null (nao ha data, nao foi estimada). ELEGIBILIDADE: CNPJ ativo; minimo 3 anos de existencia comprovada; ser associacao privada ou fundacao privada. Abrangencia nacional. OPORTUNIDADE APROVEITAVEL EM GOIAS."
  },
  "546b96172a0f625ea0db": {
    "objeto": "Edital BNDES Periferias Fortes Nordeste (BNDES com Instituto Ekloos): promover o fortalecimento institucional de 85 organizacoes sociais que atuam em favelas e comunidades urbanas, por meio de capacitacoes, mentorias e apoio financeiro de ate R$ 100 mil (pequeno porte) ou ate R$ 300 mil (medio porte), com 6 meses de mentorias remotas individuais e 12 capacitacoes online.",
    "inicio": "2026-06-30", "fim": "2026-08-18",
    "pagina_oficial": "https://www.ekloos.org/periferiasfortes",
    "observacao": "ENCERRADO - a pagina oficial marca 'Inscricoes encerradas'. Cronograma: inicio 30/06/2026 as 10h; encerramento 18/08/2026 as 18h; avaliacao 13/08 a 29/10/2026; resultado final 30/10/2026. ABRANGENCIA RESTRITA AO NORDESTE (AL, BA, CE, PB, PE, PI, RN, SE) - nao alcanca Goias. Existe edital irmao para Norte e Maranhao com inscricoes ate 20/09/2026 (https://periferiasfortes.phi.org.br/), tambem fora de Goias."
  },
  "7e4d2f0cf2bee7a138b8": {
    "objeto": "Edital Encantando Comunidades: Recursos Flexiveis - 2a edicao, do Instituto Lojas Renner: oferecer apoio financeiro para que organizacoes da sociedade civil sem fins lucrativos invistam em necessidades institucionais (infraestrutura, equipamentos, tecnologia, comunicacao, capacitacao, gestao, melhoria de processos), fortalecendo sua atuacao e sustentabilidade. Ate 30 organizacoes selecionadas, ate R$ 10 mil cada.",
    "inicio": "2026-08-12", "fim": "2026-09-13",
    "pagina_oficial": "https://www.institutolojasrenner.org.br/edital-encantando-comunidades/",
    "observacao": "ABERTO em 2026-09-07, encerra 13/09/2026. Cronograma oficial: lancamento 12/08/2026; live tira-duvidas 02/09/2026; termino das inscricoes 13/09/2026; resultado 23/09/2026. ABRANGENCIA RESTRITA a Porto Alegre/RS (Comunidade Bom Jesus), Zona Oeste do Rio de Janeiro/RJ e Cabreuva, Itu, Jundiai, Pirapora do Bom Jesus, Porto Feliz, Sorocaba e Votorantim/SP - NAO alcanca Goias."
  },
  "f901a7304e32de7b7f33": {
    "objeto": "Edital Encantando Comunidades: Recursos Flexiveis - 2a edicao, do Instituto Lojas Renner: apoio financeiro de ate R$ 10 mil para ate 30 OSCs investirem em necessidades institucionais.",
    "inicio": "2026-08-12", "fim": "2026-09-13",
