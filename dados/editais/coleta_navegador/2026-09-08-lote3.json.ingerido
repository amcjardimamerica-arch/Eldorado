 "31b8a937a989d196a8b7": {
  "objeto": "Chamada Publica no SS-CH001/2025 da Secretaria de Saude de Nova Russas/CE - chamamento publico de entidades privadas, sem fins lucrativos, interessadas em se qualificarem como ORGANIZACAO SOCIAL na area de saude, para habilitacao para eventual e futuro gerenciamento.",
  "inicio": "2025-01-31",
  "fim": "2025-03-06",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07993439000101/compras/2025/16/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO: nao e edital de fomento a OSC. *** E qualificacao previa como Organizacao Social de saude - habilitacao para eventual e futuro gerenciamento, sem repasse vinculado nem projeto. Lido no PDF do edital do proprio municipio (17p) + aviso + adendo hospedados no PNCP: recebimento de documentos 'a partir do dia 31 de janeiro de 2025 a 24 de fevereiro de 2025' na Rua Padre Francisco Rosa 1388, Centro; o ADENDO do mesmo registro prorrogou o recebimento 'para ate o dia 06 de marco de 2025, de 08h00min as 14h00min' - e essa a data valida. Edital ENCERRADO."
 },
 "43ec6258b8523a140c08": {
  "objeto": "Edital de Chamamento Publico no ST-CP001/2026 de Senador Pompeu/CE - selecao de Organizacoes da Sociedade Civil (OSC) interessadas em celebrar Termo de Fomento para execucao de acoes voltadas a promocao, protecao e defesa dos direitos de criancas e adolescentes, em consonancia com o ECA e com as diretrizes estadual e municipal. Recursos do Fundo Municipal dos Direitos da Crianca e do Adolescente (FIA).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07728421000182/compras/2026/59/arquivos/1",
  "observacao": "Municipio de Senador Pompeu/CE (COMDICASP / Secretaria do Trabalho). O PDF do edital (46p) hospedado no PNCP e um DIGITALIZADO DE BAIXA QUALIDADE: a extracao de texto sai corrompida ('Ponnpeu', 'setennbro', 'dejulho') e NAO recupera nenhuma data de inscricao - so as datas das leis citadas e a assinatura em 02/06/2026. Por isso inicio e fim ficam null em vez de uma data plausivel. PISTA para conferencia: o metadado do PNCP declara janela de 03/06/2026 a 06/07/2026 - e metadado, nao o edital, entao precisa ser confirmado com o municipio antes de virar dado. Edital provavelmente encerrado."
 },
 "caa19170eb41534c9368": {
  "objeto": "Chamada Publica no 005/2025-CP do Municipio de Ocara/CE - selecao de Organizacoes da Sociedade Civil (OSC) interessadas em celebrar Termo de Fomento.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/12459616000104/compras/2025/143/arquivos/1",
  "observacao": "Municipio de Ocara/CE. Os TRES documentos anexados ao registro (edital 17p, avisos e publicacoes 5p, pedido de impugnacao) sao imagens digitalizadas SEM CAMADA DE TEXTO: a extracao devolveu zero caractere em todos. Nao ha como confirmar objeto detalhado nem prazo sem OCR. Por isso inicio e fim ficam null. PISTA para conferencia: o metadado do PNCP declara janela de 01/10/2025 a 24/10/2025 - e metadado, nao o edital. Existe pedido de impugnacao ao edital anexado ao registro, o que sugere que o certame teve controversia; conferir com o municipio antes de reaproveitar."
 },
 "d19c6f466e3d3c7c32d4": {
  "objeto": "Edital de Chamamento Publico no 001/2024 do Municipio de Acopiara/CE - abertura, em carater emergencial, do processo de QUALIFICACAO de entidades privadas sem fins lucrativos como ORGANIZACAO SOCIAL na area da saude, visando a futura celebracao de contrato de gestao.",
  "inicio": "2024-10-16",
  "fim": "2024-10-31",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07847379000119/compras/2024/118/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO: nao e edital de fomento a OSC. *** E qualificacao previa como Organizacao Social de saude (Lei Federal 9.637/98, Decreto Municipal 0253/2024), sem repasse vinculado nem projeto. Prazo lido no PDF do aviso oficial do municipio (8p) hospedado no PNCP: entrega na sede da Prefeitura, Av. Jose Marques Filho 600, Centro, 'entre os dias 16/10/2024 a 31/10/2024'. Documento assinado em 14/10/2024. DIVERGENCIA: o metadado do PNCP registra 21/10 a 31/10/2024 - vale o edital. Edital ENCERRADO."
 },
 "dc73999357ed4e37d07f": {
  "objeto": "Edital de Chamamento Publico no SS-CH001/2026 de Senador Pompeu/CE - selecao de propostas para celebracao de parceria com a Secretaria Municipal de Saude, por meio de Termo de Colaboracao com Organizacoes da Sociedade Civil, em conformidade com a missao institucional da secretaria.",
  "inicio": "2026-02-03",
  "fim": "2026-03-05",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07728421000182/compras/2026/16/arquivos/1",
  "observacao": "Municipio de Senador Pompeu/CE. Item 7.4.1 lido no PDF do edital do proprio municipio (79p) hospedado no PNCP: 'As propostas e documentacoes para credenciamento serao apresentadas pelas OSCs, em envelope lacrado, a partir do dia 03 de FEVEREIRO de 2026 ate o dia 05 de MARCO de 2026, as 09:00 horas, no horario de expediente'. Confere com o metadado do PNCP (03/02 a 05/03/2026). Entrega PRESENCIAL em envelope lacrado. O PDF e digitalizado e a extracao sai com ruido, mas o trecho do prazo esta legivel. Edital ENCERRADO."
 },
 "248f790790781eb96dce": {
  "objeto": "Edital de Chamamento Publico no 001/2024 do Municipio de Horizonte/CE - termo de fomento para concessao de apoio da administracao publica municipal a execucao de programas e projetos de fomento e desenvolvimento do esporte de alto rendimento, amador e educacional.",
  "inicio": "2024-03-13",
  "fim": "2024-04-12",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/23555196000186/compras/2024/6/arquivos/1",
  "observacao": "Municipio de Horizonte/CE. Tabela da fase de selecao lida no PDF do edital do proprio municipio (42p) hospedado no PNCP: 'Publicacao do Edital 13/03/2024; Envio das propostas pelas OSCs 13.03.2024 a 12.04.2024'. DIVERGENCIA: o metadado do PNCP registra 08/05/2024 nas duas pontas - vale o edital. Vigencia da parceria ate 31/12/2024. Edital ENCERRADO."
 },
 "a2e23f84f60e8ace4d9e": {
  "objeto": "Edital de Chamamento Publico no 2606.01/2024 do Municipio de Senador Sa/CE - selecionar Organizacao da Sociedade Civil sem fins lucrativos para firmar parceria em regime de mutua colaboracao (Secretaria Municipal de Saude).",
  "inicio": "2024-07-02",
  "fim": "2024-08-01",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07598642000183/compras/2024/15/arquivos/2",
  "observacao": "Municipio de Senador Sa/CE. Localizei o registro pela busca do PNCP (o link capturado era do BNC Compras, plataforma privada). Li a versao RETIFICADA do edital (52p) alem do original e do primeiro adendo, todos anexados ao registro. Item 1.2 e a tabela da 1a etapa concordam: 'Publicacao do Edital de Chamamento Publico - Minimo 30 dias (02/07/2024 a 01/08/2024)' e entrega na Av. Estanislau Juliao s/n, Centro, 'a partir da publicacao do presente edital, ate as 17h00min do dia 01/08/2024'. Comissao de Selecao nomeada pela portaria SMS/CE 007/2024 de 20/06/2024. ENCERRADO. Contato: (88) 3668-1003."
 },
 "6695f89b3176a843e827": {
