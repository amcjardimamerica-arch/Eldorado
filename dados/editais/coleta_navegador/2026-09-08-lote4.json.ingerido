{
 "e8de25d724d1de2c80b0": {
  "objeto": "Edital de Chamamento Publico no 001/2026-SEMUS/PMPR do Municipio de Paulo Ramos/MA - selecao de Organizacao da Sociedade Civil (Lei 13.019/2014) para celebracao de Termo de Fomento visando a execucao de acoes especializadas em OFTALMOLOGIA (consultas, exames, laudos, prescricao optica e fornecimento de oculos), no ambito do Programa Mais Acesso a Especialistas (PMAE) / Oferta de Cuidados Integrados (OCI), em regime de mutua cooperacao com a Administracao Publica Municipal.",
  "inicio": null,
  "fim": "2026-07-03",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/06029524000191/compras/2026/32/arquivos/1",
  "observacao": "Municipio de Paulo Ramos/MA (SEMUS). Item 3 lido no PDF do documento oficial do municipio (30p) hospedado no PNCP: entrega presencial em dias uteis, exceto pontos facultativos, 'ou por meio eletronico atraves do endereco: licitacao@pauloramos.ma.gov.br, ate o dia 03 de julho de 2026'. Edital assinado em 29/05/2026 e vigente a partir da publicacao no Diario Oficial do Municipio - nao ha data de abertura expressa, por isso inicio fica null. Aceita envio por E-MAIL. Confere com o metadado do PNCP (02/06 a 03/07/2026). Perfil especifico: entidade com capacidade de operar servico oftalmologico. ENCERRADO."
 },
 "d68b52c19517b5fe511c": {
  "objeto": "Edital de Credenciamento no 003/2024 do Municipio de Caxias/MA - formalizacao de termo de colaboracao de finalidade de interesse publico e reciproco que envolve a execucao do gerenciamento, operacionalizacao e execucao das acoes e servicos de saude na MATERNIDADE CARMOSINA COUTINHO.",
  "inicio": "2024-07-05",
