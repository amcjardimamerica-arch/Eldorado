 "95ca296b9b2eb1502b2f": {
  "objeto": "Edital de Chamamento Publico no 6/2026 do Municipio de Araquari/SC (Lei 13.019/2014 e Decreto Municipal 36/2025) - Termo de Colaboracao para concessao de apoio da administracao publica a execucao do Servico de Acolhimento Institucional, na modalidade CASA DE PASSAGEM, para atendimento provisorio.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/08345500000177/compras/2026/15/arquivos/1",
  "observacao": "Municipio de Araquari/SC. O PDF do edital (52p) hospedado no PNCP foi lido integralmente. O item 8 DA FASE DE SELECAO traz a tabela de etapas ('1o Publicacao do Edital; 2o Envio das propostas pela OSC; 3o Avaliacao...') mas a COLUNA DE DATAS ESTA VAZIA no documento - o edital foi publicado sem preencher o cronograma. A varredura completa de datas no texto so encontra a assinatura do Secretario de Administracao em 22/04/2026. Por isso inicio e fim ficam null: a omissao e do proprio edital. Para fechar, pedir o cronograma ao municipio."
 },
 "985081b8a9c67099babc": {
  "objeto": "Edital de Chamamento Publico no 08/2023-FMAS do Municipio de Guaramirim/SC - Termo de Fomento para financiamento, por intermedio do Fundo Municipal de Assistencia Social, de projetos inovadores e/ou complementares a politica de assistencia social.",
  "inicio": "2023-07-18",
  "fim": "2023-08-18",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/13884310000168/compras/2023/11/arquivos/1",
  "observacao": "Municipio de Guaramirim/SC. Cronograma lido no PDF do edital do proprio municipio (45p) hospedado no PNCP: 'Publicacao do Edital 18/07/2023; Prazo limite para entrega das propostas de projeto pelas OSCs 18/08/2023; Etapa competitiva de avaliacao 19 a 25/08/2023'. O item 13.2.2.5 confirma: copia da proposta por e-mail (conselhos@guaramirim.sc.gov.br) ou entrega em CD/pendrive 'ate o dia 18/08/2023'. RESSALVA: o documento e identificado como 'MINUTA DE EDITAL' no proprio cabecalho, embora publicado no PNCP. Exige inscricao regular da OSC nos conselhos. ENCERRADO (2023). Contato: (47) 3373-0166."
 },
