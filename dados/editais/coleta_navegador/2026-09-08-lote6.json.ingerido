 "72c1599531991b1ac933": {
  "objeto": "Edital de Chamamento Publico no 02/2024 da Fundacao de Esportes de Campo Mourao (FECAM)/PR - parceria por Termo de Fomento/Colaboracao para aplicacao de recursos em projetos esportivos na manifestacao do esporte escolar, com execucao ate 31/12/2024. Fundamento: Lei Municipal 1714/2013.",
  "inicio": "2024-06-26",
  "fim": "2024-07-26",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/80889108000116/compras/2024/84/arquivos/1",
  "observacao": "Fundacao de Esportes de Campo Mourao/PR (processo administrativo 35/2024). Item 2.1 lido no PDF do edital do proprio orgao (50p) hospedado no PNCP: entrega no Departamento Administrativo e Financeiro da FECAM, Rua Robson Daciuk Paitach 379, 'no periodo de 26/06/2024 a 26/07/2024, das 08h30min as 11h30min e das 13h30min as 17h'. Entrega PRESENCIAL. Termo de fomento com vigencia ate 31/01/2025 e uso dos recursos ate 31/12/2024. ENCERRADO."
 },
 "76d1259c4c611525eb22": {
  "objeto": "Edital de Chamamento Publico (Processo Administrativo 183/2024, Inexigibilidade 39/2024) para celebracao de Termo de Colaboracao com entidade que ofereca servico de Acolhimento Institucional para jovens e adultos - Residencia de Apoio.",
