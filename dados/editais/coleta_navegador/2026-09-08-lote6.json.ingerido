 "370a35b17408d622d9aa": {
  "objeto": "Chamamento/Credenciamento no 007/2024 da Prefeitura Municipal de Luiziana/PR - selecao de projetos de capacitacoes, acoes educativas, de formacao e/ou qualificacao na area cultural, com recursos da Politica Nacional Aldir Blanc de Fomento a Cultura (PNAB, Lei 14.399/2022).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://luiziana.eloweb.net/portaltransparencia/licitacoes",
  "observacao": "Municipio de Luiziana/PR. O registro do PNCP traz o AVISO (2p) e um 'EDITAL PNAB 007.2024 Cultura.pdf' que nao rendeu texto util. O aviso diz 'conforme cronograma abaixo' mas o cronograma nao veio na camada de texto extraida; a unica data recuperada e a assinatura da pregoeira em 01/07/2024. Por isso inicio e fim ficam null. A pagina_oficial aqui e a do proprio municipio, indicada no aviso: 'O edital encontra-se disponivel no site https://luiziana.eloweb.net/portaltransparencia/licitacoes' - portal Eloweb, que so abre com navegador."
 },
 "4e8961e172feb22c5227": {
  "objeto": "Termo de Colaboracao para apoio cultural com entidades mantenedoras de radios comunitarias.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/75368928000122/compras/2024/17/arquivos/1",
  "observacao": "O unico documento anexado ao registro do PNCP e um arquivo .doc (Word binario antigo, edital_30_2024_2981_documento.doc), formato que nao permite extracao de texto pelas ferramentas disponiveis - nao e PDF nem docx/zip. Nao ha objeto detalhado nem prazo verificaveis. inicio e fim ficam null. Para resolver, abrir o .doc no Word ou pedir a versao em PDF ao municipio."
 },
 "81a7f79723fe650d4d68": {
