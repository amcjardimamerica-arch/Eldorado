{
 "2a117bef388182e6cf5b": {
  "objeto": "Edital de Chamamento Publico no 19/2025 (Lei Federal 13.019/2014 quando couber e Lei Municipal 7.703/2021) - selecao de acoes ou atividades relativas a eventos de carater musical, turistico e cultural, publico e gratuito, alusivos ao Calendario Oficial de Eventos do Municipio de Lagoa Vermelha, a serem realizados no quarto trimestre de 2025 (outubro a dezembro), mediante cota de patrocinio.",
  "inicio": "2025-08-18",
  "fim": "2025-10-17",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/87613626000151/compras/2025/520/arquivos/1",
  "observacao": "Duplicata de a902f9b63006946ca43e - mesmo edital, mesmo orgao; resposta replicada. Municipio de Lagoa Vermelha/RS. Item 2 DAS INSCRICOES lido no PDF do edital do proprio municipio (23p) hospedado no PNCP: 'As inscricoes estarao abertas no periodo de 18 de Agosto de 2025 ate 17 de Outubro de 2025'. Confere com o cronograma. Edital ENCERRADO."
 },
 "196d0569cd32c3ab9ee7": {
  "objeto": "Edital de Concurso Eletronico no 0001/2025 'OSVALDO SETTE' do Municipio de Xanxere/SC (processo administrativo 0161/2025) - concurso para selecao de 14 (quatorze) projetos culturais nas categorias Formacao e Producao, que contribuam para a producao, difusao, fomento, consumo, reflexao e profissionalizacao artistica.",
