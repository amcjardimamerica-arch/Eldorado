 "49373ee8da52fa1ed6a0": {
  "objeto": "Edital de Chamamento Publico no 54/2024 - selecao de projetos para firmar Termo de Execucao Cultural com recursos da PNAB (Lei 14.399/2022): concessao de apoio financeiro a acoes culturais.",
  "inicio": "2024-09-04",
  "fim": "2024-09-23",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/95990255000155/compras/2024/60/arquivos/1",
  "observacao": "Item 2.4 lido no PDF do edital do proprio municipio (51p) hospedado no PNCP. RESSALVA: o proprio edital diverge no horario final - o item 2.4 diz 'De 04 de setembro de 2024 ate as 16 horas e 59 minutos do dia 23 de setembro de 2024' e a tabela 2.4.1 diz 'De 08h00min do dia 04/09/2024 ate as 17 horas do dia 23/09/2024'. A DATA e a mesma nas duas (23/09/2024); a divergencia e de minutos e nao afeta o campo. Homologacao das inscricoes 24/09/2024. ENCERRADO."
 },
 "5b2002af84d7311550c8": {
  "objeto": "Concurso para selecao de 14 (quatorze) projetos culturais nas Categorias EVENTOS (realizacao de mostras, feiras, festivais e similares) - Municipio de Xanxere/SC.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://xanxere.sc.gov.br/estrutura/pagina-809/politica-nacional-aldir-blanc-de-fomento-a-cultura-pnab/",
  "observacao": "Municipio de Xanxere/SC. E edital IRMAO do item 196d0569 (mesmo formato de concurso de 14 projetos culturais), mas na categoria EVENTOS. Naveguei o site oficial do municipio com navegador real: a pagina da PNAB lista apenas 'Edital de Fomento no 04/2024' e 'Edital Pontos e Pontoes de Cultura' - nao publica o concurso de categoria Eventos; a secao de Concursos da Secretaria de Esportes, Cultura e Lazer so traz processos seletivos de pessoal. O link capturado e do Comprasnet (sistema de origem, nao fonte). Sem o edital, nao ha prazo verificavel: inicio e fim ficam null. PISTA: se seguir o mesmo calendario do concurso de Formacao e Producao, a janela teria sido 17/06 a 07/08/2025 - mas isso e inferencia, nao dado, e por isso nao foi gravado. Contato: esportes@xanxere.sc.gov.br, (49) 3441-8509."
 },
 "6b796839bffa7cf14fdc": {
