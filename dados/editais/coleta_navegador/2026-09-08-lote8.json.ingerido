{
 "1eaba08f0097a3439216": {
  "objeto": "Selecao de projetos culturais ineditos propostos por agentes culturais - pessoas fisicas (ou coletivos representados por pessoa fisica) residentes em Novo Hamburgo e pessoas juridicas com sede no Municipio, visando o fomento a producao artistica e cultural com recursos do Fundo Municipal de Cultura. Valor total R$ 575.000,00 em 4 modalidades.",
  "inicio": "2024-11-01",
  "fim": "2024-12-12",
  "pagina_oficial": "https://www.novohamburgo.rs.gov.br/secult/editais/editalfomento-112024",
  "observacao": "Chamamento Publico Cultural 11/2024 (Funcultura). Objeto e prazo lidos na propria pagina oficial da SECULT: 'As inscricoes poderao ser realizadas de 1o de novembro de 2024 ate as 18h do 12 de dezembro de 2024'. Edital ENCERRADO - resultado final homologado em 04/2025 e convocacao de suplentes em 06/2025. Nao entra no funil de captacao."
 },
 "279fd5164589758e182c": {
  "objeto": "Chamamento Publico no 21/2024 do Municipio de Passo Fundo/RS (FUMUI/SEMCAS, processo interno 2024/18122) - selecao de Organizacoes da Sociedade Civil sem fins lucrativos para celebrar Termo de Colaboracao, voltadas ao atendimento de pessoas idosas com idade igual ou superior a 60 anos.",
  "inicio": "2024-08-28",
  "fim": "2024-09-29",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/87612537000190/compras/2024/208/arquivos/1",
  "observacao": "Municipio de Passo Fundo/RS. Item 4 DAS INSCRICOES lido no PDF do edital do proprio municipio (9p, dentro do pacote .zip anexado ao PNCP): 'O periodo de inscricoes sera de 28 de Agosto a 29 de Setembro de 2024'. Confere com o Aviso de Edital. Inscricao por E-MAIL: credenciamento@pmpf.rs.gov.br. Telefones (54) 3316-7124 / 3316-7125. ENCERRADO."
 },
 "2e9711152378cd8aacd9": {
  "objeto": "Chamamento Publico no 23/2024 do Municipio de Passo Fundo/RS (COMDICA/SEMCAS, processo interno 2024/15849) - selecao de projetos apresentados por Organizacoes da Sociedade Civil sem fins lucrativos para celebrar Termo de Fomento, voltados ao atendimento de criancas e adolescentes em situacao de vulnerabilidade.",
  "inicio": "2024-09-06",
