 "1eaba08f0097a3439216": {
  "objeto": "Selecao de projetos culturais ineditos propostos por agentes culturais - pessoas fisicas (ou coletivos representados por pessoa fisica) residentes em Novo Hamburgo e pessoas juridicas com sede no Municipio, visando o fomento a producao artistica e cultural com recursos do Fundo Municipal de Cultura. Valor total R$ 575.000,00 em 4 modalidades.",
  "inicio": "2024-11-01",
  "fim": "2024-12-12",
  "pagina_oficial": "https://www.novohamburgo.rs.gov.br/secult/editais/editalfomento-112024",
  "observacao": "Chamamento Publico Cultural 11/2024 (Funcultura). Objeto e prazo lidos na propria pagina oficial da SECULT: 'As inscricoes poderao ser realizadas de 1o de novembro de 2024 ate as 18h do 12 de dezembro de 2024'. Edital ENCERRADO - resultado final homologado em 04/2025 e convocacao de suplentes em 06/2025. Nao entra no funil de captacao."
 },
 "80529ad515742473b8f5": {
  "objeto": "Selecao de projetos culturais propostos por agentes culturais que constituem espacos, ambientes e iniciativas artistico-culturais mantidos por pessoas, OSC, microempresas culturais, organizacoes culturais comunitarias, cooperativas e instituicoes culturais sem fins lucrativos com pelo menos 2 anos de funcionamento regular em Novo Hamburgo. Subsidio para manutencao: 24 vagas de R$ 3.645,00 (R$ 87.480,00).",
  "inicio": "2024-10-02",
  "fim": "2024-10-21",
  "pagina_oficial": "https://www.novohamburgo.rs.gov.br/smc/pnab/editalsubsidio-102024",
  "observacao": "Chamamento Publico Cultural 10/2024 - PNAB. Prazo lido na pagina oficial da SECULT: 'As inscricoes sao gratuitas e poderao ser realizadas de 2 de outubro ate as 18h do dia 21 de outubro de 2024'. Edital ENCERRADO."
 },
 "dcb954069dd462c887e4": {
