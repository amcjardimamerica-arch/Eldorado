 "43ec6258b8523a140c08": {
  "objeto": "Edital de Chamamento Publico no ST-CP001/2026 de Senador Pompeu/CE - selecao de Organizacoes da Sociedade Civil (OSC) interessadas em celebrar Termo de Fomento para execucao de acoes voltadas a promocao, protecao e defesa dos direitos de criancas e adolescentes, em consonancia com o ECA e com as diretrizes estadual e municipal. Recursos do Fundo Municipal dos Direitos da Crianca e do Adolescente (FIA).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07728421000182/compras/2026/59/arquivos/1",
  "observacao": "Municipio de Senador Pompeu/CE (COMDICASP / Secretaria do Trabalho). O PDF do edital (46p) hospedado no PNCP e um DIGITALIZADO DE BAIXA QUALIDADE: a extracao de texto sai corrompida ('Ponnpeu', 'setennbro', 'dejulho') e NAO recupera nenhuma data de inscricao - so as datas das leis citadas e a assinatura em 02/06/2026. Por isso inicio e fim ficam null em vez de uma data plausivel. PISTA para conferencia: o metadado do PNCP declara janela de 03/06/2026 a 06/07/2026 - e metadado, nao o edital, entao precisa ser confirmado com o municipio antes de virar dado. Edital provavelmente encerrado."
 },
 "248f790790781eb96dce": {
  "objeto": "Edital de Chamamento Publico no 001/2024 do Municipio de Horizonte/CE - termo de fomento para concessao de apoio da administracao publica municipal a execucao de programas e projetos de fomento e desenvolvimento do esporte de alto rendimento, amador e educacional.",
  "inicio": "2024-03-13",
  "fim": "2024-04-12",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/23555196000186/compras/2024/6/arquivos/1",
  "observacao": "Municipio de Horizonte/CE. Tabela da fase de selecao lida no PDF do edital do proprio municipio (42p) hospedado no PNCP: 'Publicacao do Edital 13/03/2024; Envio das propostas pelas OSCs 13.03.2024 a 12.04.2024'. DIVERGENCIA: o metadado do PNCP registra 08/05/2024 nas duas pontas - vale o edital. Vigencia da parceria ate 31/12/2024. Edital ENCERRADO."
 },
 "dc73999357ed4e37d07f": {
  "objeto": "Edital de Chamamento Publico no SS-CH001/2026 de Senador Pompeu/CE - selecao de propostas para celebracao de parceria com a Secretaria Municipal de Saude, por meio de Termo de Colaboracao com Organizacoes da Sociedade Civil, em conformidade com a missao institucional da secretaria.",
  "inicio": "2026-02-03",
  "fim": "2026-03-05",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07728421000182/compras/2026/16/arquivos/1",
  "observacao": "Municipio de Senador Pompeu/CE. Item 7.4.1 lido no PDF do edital do proprio municipio (79p) hospedado no PNCP: 'As propostas e documentacoes para credenciamento serao apresentadas pelas OSCs, em envelope lacrado, a partir do dia 03 de FEVEREIRO de 2026 ate o dia 05 de MARCO de 2026, as 09:00 horas, no horario de expediente'. Confere com o metadado do PNCP (03/02 a 05/03/2026). Entrega PRESENCIAL em envelope lacrado. O PDF e digitalizado e a extracao sai com ruido, mas o trecho do prazo esta legivel. Edital ENCERRADO."
 },
 "d19c6f466e3d3c7c32d4": {
  "objeto": "Edital de Chamamento Publico no 001/2024 do Municipio de Acopiara/CE - abertura, em carater emergencial, do processo de QUALIFICACAO de entidades privadas sem fins lucrativos como ORGANIZACAO SOCIAL na area da saude, visando a futura celebracao de contrato de gestao.",
  "inicio": "2024-10-16",
  "fim": "2024-10-31",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07847379000119/compras/2024/118/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO: nao e edital de fomento a OSC. *** E qualificacao previa como Organizacao Social de saude (Lei Federal 9.637/98, Decreto Municipal 0253/2024), sem repasse vinculado nem projeto. Prazo lido no PDF do aviso oficial do municipio (8p) hospedado no PNCP: entrega na sede da Prefeitura, Av. Jose Marques Filho 600, Centro, 'entre os dias 16/10/2024 a 31/10/2024'. Documento assinado em 14/10/2024. DIVERGENCIA: o metadado do PNCP registra 21/10 a 31/10/2024 - vale o edital. Edital ENCERRADO."
 },
 "caa19170eb41534c9368": {
  "objeto": "Chamada Publica no 005/2025-CP do Municipio de Ocara/CE - selecao de Organizacoes da Sociedade Civil (OSC) interessadas em celebrar Termo de Fomento.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/12459616000104/compras/2025/143/arquivos/1",
  "observacao": "Municipio de Ocara/CE. Os TRES documentos anexados ao registro (edital 17p, avisos e publicacoes 5p, pedido de impugnacao) sao imagens digitalizadas SEM CAMADA DE TEXTO: a extracao devolveu zero caractere em todos. Nao ha como confirmar objeto detalhado nem prazo sem OCR. Por isso inicio e fim ficam null. PISTA para conferencia: o metadado do PNCP declara janela de 01/10/2025 a 24/10/2025 - e metadado, nao o edital. Existe pedido de impugnacao ao edital anexado ao registro, o que sugere que o certame teve controversia; conferir com o municipio antes de reaproveitar."
 },
 "4c33635685d7c762cedb": {
  "objeto": "Edital de Selecao Publica no 001/2024 do Municipio de Itapemirim/ES - selecao de Entidade Fechada de Previdencia Complementar (EFPC) para administracao de plano de beneficios previdenciarios dos servidores publicos da administracao direta e indireta.",
  "inicio": null,
  "fim": "2024-04-26",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/27174168000170/compras/2024/284/arquivos/1",
  "observacao": "*** NAO SERVE PARA CAPTACAO DE OSC. *** O titulo capturado na base diz 'selecao de pessoa juridica de direito privado, sem fins lucrativos' e por isso o item entrou na lista, mas o edital lido (22p, hospedado no PNCP) mostra que a pessoa juridica em questao e uma ENTIDADE FECHADA DE PREVIDENCIA COMPLEMENTAR para administrar o plano de previdencia dos servidores - nao ha fomento nem repasse a OSC. Cronograma: publicacao 05/04/2024, retificacao 18/04/2024, 'Envio e recebimento das documentacoes de habilitacao e das propostas tecnicas pelas Entidades interessadas: Ate 26/04/2024'. Nao ha data de inicio fixada, por isso inicio fica null. ENCERRADO."
 },
 "c398fe0faee0394d5113": {
  "objeto": "Chamamento Publico do CONFEA (Conselho Federal de Engenharia e Agronomia) - promover chamamento de pessoas fisicas ou juridicas de direito privado ou publico para firmar acordos de patrocinio, nao exclusivos, para a 81a Semana Oficial da Engenharia e Agronomia (SOEA), conforme cotas de patrocinio do Anexo 4.",
  "inicio": null,
  "fim": "2026-06-19",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/33665647000191/compras/2026/38/arquivos/1",
  "observacao": "*** NAO SERVE PARA CAPTACAO DE OSC. *** E o Confea BUSCANDO PATROCINADOR para seu evento (recurso entrando no conselho), nao repassando recurso a entidade. Item 2.4 lido no PDF oficial do Confea (Midia Kit da 81a SOEA, 37p) hospedado no PNCP: 'As propostas deverao ser enviadas da data da publicacao desse edital ate 19 de junho de 2026'. Como o inicio e 'a data da publicacao' sem data expressa no trecho, inicio fica null. ENCERRADO."
 },
 "f1ca92b53138bf67e586": {
  "objeto": "Edital de Chamamento Publico no 001/2025/SMC-CHP da Secretaria de Cultura, Turismo, Esporte e Juventude de Carire/CE - selecao de organizacao da sociedade civil sem fins lucrativos para firmar parceria (Termo de Colaboracao) em regime de mutua colaboracao, com transferencia de recursos financeiros. Projeto REISADO.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07598600000142/compras/2025/4/arquivos/1",
  "observacao": "Municipio de Carire/CE. O PDF do edital (40p, marcado como 'PESQUISAVEL') foi lido integralmente e NAO contem prazo de inscricao nem cronograma: traz objeto, vedacoes, minuta do termo e vigencia ate 31/12/2025, mas nenhuma janela de apresentacao de propostas. Por isso inicio e fim ficam null - a omissao e do proprio edital, nao da leitura. PISTA para conferencia: o metadado do PNCP declara 03/01/2025 a 07/01/2025 (janela de 5 dias, corridos no inicio do ano) - conferir com o municipio, porque prazo tao curto e materia de impugnacao. ENCERRADO."
 },
 "11768ed9d6ef89878efe": {
  "objeto": "Edital de Chamamento Publico no 04/2026 do Municipio de Governador Luiz Rocha/MA - concessao de apoio financeiro a acoes culturais nos termos da PNAB (Lei 14.399/2022) e da Lei 14.903/2024, para firmar Termo de Execucao Cultural. Aberto a agente cultural pessoa fisica e a grupos e coletivos que atuem e residam no municipio.",
  "inicio": "2026-04-23",
  "fim": "2026-04-29",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/01578554000133/compras/2026/11/arquivos/1",
  "observacao": "Municipio de Governador Luiz Rocha/MA. Item 2.4 lido no PDF do edital do proprio municipio (30p) hospedado no PNCP: 'Prazo de inscricao: 23 de abril ate 29 de abril de 2026'. DIVERGENCIA relevante: o metadado do PNCP declara 05/05/2026 a 13/05/2026 - vale o edital (23 a 29/04). O cronograma do edital preve divulgacao das inscricoes admitidas em 14/05/2026. Janela de apenas 7 dias. ENCERRADO."
 },
 "63d4a2a3748953c0568b": {
  "objeto": "Edital de Chamamento Publico no 01/2024 do Municipio de Wenceslau Braz/MG (Secretaria de Cultura e Turismo) - selecao de projetos para firmar Termo de Execucao Cultural com recursos da Politica Nacional Aldir Blanc de Fomento a Cultura (PNAB, Lei 14.399/2022).",
  "inicio": "2024-11-01",
  "fim": "2024-11-07",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/18026013000103/compras/2024/110/arquivos/1",
  "observacao": "Municipio de Wenceslau Braz/MG. Item 2.4 lido no PDF do edital do proprio municipio (11p) hospedado no PNCP: 'Prazo de inscricao e prazo final de cumprimento dos projetos: De 01/11/2024 ate 07/11/2024'. O metadado do PNCP nao traz janela nenhuma (datas nulas), so a publicacao em 06/11/2024 - ou seja, o edital foi divulgado no PNCP com as inscricoes praticamente encerradas. Janela de 7 dias. ENCERRADO."
 },
 "832b4ebf5f1b167a198e": {
  "objeto": "Edital de Chamamento Publico no 112/2024 do Municipio de Ribeirao das Neves/MG - premiacao de agentes culturais que tenham prestado relevante contribuicao ao desenvolvimento artistico e cultural do municipio (Premiacoes Culturais, Artisticas, Cientificas e Desportivas).",
  "inicio": "2024-10-09",
  "fim": "2024-10-15",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/18314609000109/compras/2024/48/arquivos/1",
  "observacao": "Municipio de Ribeirao das Neves/MG, Secretaria Municipal de Esporte e Cultura. Item 2.4 lido no PDF do edital do proprio municipio (34p) hospedado no PNCP: 'Prazo de inscricao: De 08 horas do dia 09/10/2024 ate 23:59 horas do dia 15/10/2024'. Confere com o cronograma ('Periodo de Inscricao 09/10/2024 a 15/10/2024, Online e Presencial de 08hs as 17hs'), divulgacao dos inscritos 16/10/2024 e analise 18 a 24/10/2024. Publicacao em ammlicita.org.br, diariomunicipal.com.br e ribeiraodasneves.mg.gov.br. ENCERRADO."
 },
 "d6ff07772a8525e4a45c": {
  "objeto": "Edital de Chamamento Publico no 116/2024 do Municipio de Ribeirao das Neves/MG - selecao de espacos, ambientes e iniciativas artistico-culturais para receber SUBSIDIO PARA MANUTENCAO, com recursos da Lei Federal 14.399/2022 (PNAB). Aberto a agentes culturais que constituem espacos e iniciativas artistico-culturais localizados no municipio.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/18314609000109/compras/2024/50/arquivos/1",
  "observacao": "Municipio de Ribeirao das Neves/MG (Processo 133/2024). O PDF do edital (52p) foi lido integralmente. O item 1.4 'Prazo de inscricao' NAO fixa data: diz apenas '1.4.1 As inscricoes serao realizadas conforme orientacoes descritas no item 3 deste edital', e o item 3 tambem nao traz janela - o unico anexo com datas seria o 'Anexo X - Cronograma de Acoes', que nao esta no documento anexado. Varredura completa de datas no texto: so datas de leis e a assinatura em 30/09/2024. Por isso inicio e fim ficam null - a omissao e do proprio edital. PISTA: o metadado do PNCP nao declara janela. Comparar com o edital 112/2024 do mesmo municipio (item 832b4ebf), que teve inscricoes de 09 a 15/10/2024."
 },
 "ccc296e9e783767e56b2": {
  "objeto": "Credenciamento (Processo licitatorio do Municipio de Oratorios/MG) de Organizacoes da Sociedade Civil sem fins lucrativos para eventual celebracao de Termo de Colaboracao ou Termo de Fomento.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/01616836000188/compras/2024/46/arquivos/1",
  "observacao": "Municipio de Oratorios/MG. Lido no PDF do edital do proprio municipio (16p) hospedado no PNCP. E CREDENCIAMENTO DE FLUXO CONTINUO, nao tem data de encerramento: o item 1.1 diz que o recebimento se da pela plataforma Licitar Digital e na sala de licitacoes 'e tera inicio no primeiro dia util apos a publicacao deste edital'. Nao ha data expressa de inicio nem de fim no documento, por isso os dois campos ficam null - e caracteristica do instrumento, nao falha de leitura. A vigencia do contrato decorrente ia ate 31/12/2024, o que sugere que a janela de credenciamento se esgotou com o exercicio de 2024. Entrega: protocolo presencial na Rua Tabajara 297, Centro, ou plataforma Licitar Digital; contato licitacao@oratorios.mg.gov.br."
 },
 "34fcd0f7fbf6291a42f3": {
  "objeto": "Processo para selecao de entidade de direito privado, sem fins lucrativos, qualificada como Organizacao da Sociedade Civil de Interesse Publico (OSCIP), no Estado de Mato Grosso.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/03755477000175/compras/2025/124/arquivos/1",
  "observacao": "O registro no PNCP tem UM UNICO documento anexado - '03-Termo_de_Referencia_ou_Projeto_Basico...pdf' - e nao o edital. Alem disso o PDF e imagem digitalizada sem camada de texto: a extracao devolveu zero caractere. Nao ha edital nem prazo verificavel na fonte. inicio e fim ficam null. Para resolver este item e preciso pedir o edital ao municipio ou localizar o portal proprio; nao ha caminho pela documentacao publicada."
 },
 "f23f77917aa8ab75ca26": {
  "objeto": "Edital PNAB Belterra Ciclo 2 (Secretaria Municipal de Industria e Comercio, Cultura e Turismo - SEMICULT, Belterra/PA) - selecao de projetos para firmar Termo de Execucao Cultural com recursos da Politica Nacional Aldir Blanc de Fomento a Cultura.",
  "inicio": "2026-06-23",
  "fim": "2026-07-08",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/01614112000103/compras/2026/45/arquivos/1",
  "observacao": "Municipio de Belterra/PA. Item 2.3 lido no PDF do edital do proprio municipio (14p) hospedado no PNCP: 'Prazo de inscricao: Das 00h e 01m do dia 23 de junho de 2026 ate as 23h e 59m do dia 08 de julho de 2026', inscricoes exclusivamente online. O edital ainda oferecia plantao tira-duvidas para apoio a escrita de projetos (15 a 30/06/2026 online e atendimento presencial em 27/06) - detalhe util como referencia de boa pratica. Recursos da etapa de selecao 15 a 17/07/2026. ENCERRADO. Contato: semicult@belterra.pa.gov.br."
 },
 "6846a6fdc442a7edf191": {
  "objeto": "Concurso de Projetos no 001/2026 do Municipio de Sorriso/MT (Lei Federal 9.790/99 - OSCIP) - selecao de entidade de direito privado, sem fins lucrativos, qualificada como Organizacao da Sociedade Civil de Interesse Publico, para celebrar Termo de Parceria visando fomento e realizacao de atividades de interesse publico.",
  "inicio": null,
  "fim": "2026-03-06",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/03239076000162/compras/2026/26/arquivos/1",
  "observacao": "Municipio de Sorriso/MT. Item 4 DA ABERTURA lido no PDF do edital do proprio municipio (49p) hospedado no PNCP: 'Os documentos de habilitacao e propostas serao recebidos em sessao publica a ser realizada conforme abaixo indicado: Data: 06 DE MARCO DE 2026, Horario: 08H00MIN (horario oficial de Sorriso-MT), Local: Sala do Departamento de Licitacoes, Avenida Porto Alegre 2525, Centro'. Formato de LICITACAO com envelopes, nao de inscricao online: nao existe data de inicio, so a data-limite da sessao publica - por isso inicio fica null. ENCERRADO."
 },
 "6778d5aa826c7b107693": {
  "objeto": "Selecao de entidade de direito privado, sem fins lucrativos, qualificada como Organizacao da Sociedade Civil de Interesse Publico (OSCIP), para celebrar Termo de Parceria para formacao de vinculo de cooperacao, visando o fomento e realizacao de atividades de interesse publico no desenvolvimento de projetos voltados a area da SAUDE e ASSISTENCIA SOCIAL, nos termos da Lei Federal 9.790/99. Municipio de Colniza/MT.",
  "inicio": null,
  "fim": "2024-11-14",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/04213687000102/compras/2024/64/arquivos/1",
  "observacao": "Municipio de Colniza/MT, Secretaria Municipal de Administracao / Departamento de Licitacao. Item 4.1 lido no PDF do edital do proprio municipio (93p) hospedado no PNCP: 'Os documentos de habilitacao e propostas serao recebidos em sessao publica a ser realizada conforme abaixo indicado: Data: 14 de novembro de 2024, Horario: 08h00min'. Formato de licitacao com envelopes e sessao publica unica: nao ha janela de inscricao, so a data da sessao - inicio fica null. ENCERRADO."
 },
 "eaa12d99fc473fb7ac68": {
  "objeto": "Termo de Parceria com Organizacao da Sociedade Civil de Interesse Publico (OSCIP) para realizacao de atividades, eventos, consultoria, servicos e assessoria de interesse publico, atraves do desenvolvimento, acompanhamento e execucao de programas de governo - area da Saude. Municipio de Vila Rica/MT.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/03238862000145/compras/2025/97/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO. *** Municipio de Vila Rica/MT. Os documentos anexados ao registro (53p e 41p) sao digitalizacoes de qualidade muito baixa - a extracao de texto sai corrompida e ilegivel em boa parte. O que se recupera com seguranca mostra que o conteudo NAO e um edital aberto: sao demonstrativos de pagamento e prestacao de contas de um Termo de Parceria JA CELEBRADO ('REFERENTE AO TERMO 10/2024, PERIODO: 01/10/2024 a 31/10/2024', com nome de entidade e dotacao). Ou seja, e execucao de parceria vigente, nao chamada publica. inicio e fim ficam null porque nao existe fase de inscricao. Recomendacao: remover do funil."
 },
 "023bbe9cd308edd98a3d": {
  "objeto": "Edital de Chamamento Publico no 027/2024 do Municipio de Prudentopolis/PR (Inexigibilidade 90091/2024, Processo Licitatorio 315/2024) - premiacao por trajetoria cultural: premiacao para agentes culturais que tenham prestado relevante contribuicao ao desenvolvimento artistico ou cultural do municipio.",
  "inicio": "2024-10-03",
  "fim": "2024-10-25",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/77003424000134/compras/2024/325/arquivos/1",
  "observacao": "Municipio de Prudentopolis/PR. Prazo lido no PDF do edital do proprio municipio (14p) hospedado no PNCP: 'Do dia 03 de outubro de 2024 ate 08h30min do dia 25 de outubro de 2014'. ATENCAO: o edital tem ERRO DE DIGITACAO no ano final - escreve '2014' onde e 2024; adotei 25/10/2024, coerente com a vigencia do edital ate 31/12/2024 e com o inicio em 03/10/2024. Contato: cultura@prudentopolis.pr.gov.br, 0800 808 0130 ramal 8073. ENCERRADO."
 },
 "52aae9ce41ad52f83809": {
  "objeto": "Edital de Chamamento Publico no 011/2024-SEMTUDEC do Municipio de Floriano/PI - pactuacao de Termo de Colaboracao entre a Secretaria Municipal de Turismo e Desenvolvimento Economico e organizacoes da sociedade civil, para consecucao de finalidades de interesse publico com transferencia de recursos financeiros.",
  "inicio": "2024-11-01",
  "fim": "2024-11-06",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/06554067000154/compras/2024/108/arquivos/1",
  "observacao": "Municipio de Floriano/PI (SEMTUDEC). Cronograma lido no PDF do edital do proprio municipio (36p) hospedado no PNCP: publicacao do edital 31/10/2024; 'RECEBIMENTO DAS PROPOSTAS: 01 de novembro de 2024 a 06 de novembro de 2024'; divulgacao do resultado 07/11/2024; prazo para recurso 08 a 12/11/2024; resultado final 13/11/2024. Janela de apenas 6 dias, incluindo fim de semana. Contato: semtudec@floriano.pi.gov.br. ENCERRADO."
 },
 "14a08a92997115da8279": {
  "objeto": "Edital de Chamamento Publico no 013/2025 do Municipio de Ipora/PR (Inexigibilidade 017/2025) - selecao de projetos culturais com recursos da Politica Nacional Aldir Blanc de Fomento a Cultura (PNAB, Lei 14.399/2022). Aberto a agentes culturais residentes na macrorregiao da AMERIOS, CONCAM e AMUSEP ha pelo menos 2 anos; execucao em ate 6 meses.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/75738484000170/compras/2025/72/arquivos/1",
  "observacao": "Municipio de Ipora/PR. O PDF do edital (11p) hospedado no PNCP foi lido integralmente e NAO fixa datas: o item 2.4 diz apenas 'As inscricoes estarao abertas por 15 dias uteis, a contar dois dias apos a publicacao deste edital, atraves do Formulario https://forms.gle/3NM1EtjhrJbRkPQz8'. Como o prazo e relativo e depende de contagem de dias uteis a partir de uma publicacao cuja data nao consta do documento, NAO calculei a data - inicio e fim ficam null, conforme a regra de nunca estimar. Para fechar este item basta a data de publicacao no Diario Oficial do municipio."
 },
 "b1b9f55f9e5624abd95e": {
  "objeto": "Edital de Credenciamento no 87/2026 da Fundacao Municipal de Saude de Teresina/PI - credenciamento para selecao de pessoas juridicas de natureza privada, com ou sem fins lucrativos, para contratacao de servicos ambulatoriais.",
  "inicio": "2026-08-03",
  "fim": "2026-08-17",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/05522917000170/compras/2026/140/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO: nao e fomento. *** Fundacao Municipal de Saude de Teresina/PI (processo 00045.064565/2025-47, UASG 927337). E CONTRATACAO DE SERVICOS ambulatoriais mediante credenciamento, com pagamento por producao - a entidade sem fins lucrativos entra como prestadora de servico, nao como beneficiaria de fomento. Item 4 lido no PDF do edital (103p) hospedado no PNCP: 'Disponibilidade do Edital: 03/08/2026' e recebimento das documentacoes ate 'o dia 17 de agosto de 2026'. Assinado em 27/07/2026. ENCERRADO."
 },
 "72c1599531991b1ac933": {
  "objeto": "Edital de Chamamento Publico no 02/2024 da Fundacao de Esportes de Campo Mourao (FECAM)/PR - parceria por Termo de Fomento/Colaboracao para aplicacao de recursos em projetos esportivos na manifestacao do esporte escolar, com execucao ate 31/12/2024. Fundamento: Lei Municipal 1714/2013.",
