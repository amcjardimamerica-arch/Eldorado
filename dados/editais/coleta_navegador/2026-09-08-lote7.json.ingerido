 "3bede719aa233d8049b1": {
  "objeto": "Edital no 01/2026 do Municipio de Vilhena/RO - concurso de premiacao do programa 'Transforme seu Imposto em Esperanca', com distribuicao de recursos via destinacao de Imposto de Renda.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/04092706000181/compras/2026/184/arquivos/2",
  "observacao": "Municipio de Vilhena/RO. Os dois documentos anexados ao registro ('CONCURSO No 01-26 - PREMIACAO IRR.pdf' e 'EDITAL No 01-26.pdf') sao imagens digitalizadas SEM CAMADA DE TEXTO - a extracao devolveu 25 caracteres em total. inicio e fim ficam null. PISTA FORTE: e a edicao 2026 do mesmo programa do item 2beebeda (edital 01/2025 do mesmo municipio), cuja janela foi de 19/03 a 09/06 - ou seja, provavelmente ja encerrado, mas a data precisa vir do documento. Contato do orgao: semas@vilhena.ro.gov.br, (69) 3919-7021."
 },
 "c84b4b6d14a24f587635": {
  "objeto": "Edital de Chamamento Publico no 06/2025 do Municipio de Cacoal/RO (Processo 3800/2025) - chamamento destinado a instituicoes sem fins lucrativos com atividades voltadas a CAUSA ANIMAL, interessadas na DOACAO DE UM TERRENO: lote urbano no 771, area de 3.000 m2, quadra 125, setor 13, Rua das Associacoes, loteamento Regional, bairro Josino Brito, Cacoal/RO. Imovel livre e desembaracado de onus.",
  "inicio": null,
  "fim": "2025-09-05",
  "pagina_oficial": "https://transparencia.cacoal.ro.gov.br/portaltransparencia/licitacoes",
  "observacao": "Municipio de Cacoal/RO. Lido no arquivo .docx do edital do proprio municipio hospedado no PNCP (extraido de word/document.xml): 'DATA DA ABERTURA DA SESSAO: 05/09/2025 as 09h00' e 'A sessao publica sera conduzida sob forma presencial, no dia 05 de setembro de 2025 as 09h:00min'. Edital assinado em 21/07/2025. So ha data de sessao, sem janela de inscricao - inicio fica null. NAO HA REPASSE FINANCEIRO: o beneficio e a doacao do terreno, com encargos (o edital tem anexo de 'ciencia de encargos e prazos' e minuta de contrato de doacao). Muito especifico - so serve a entidade de causa animal em Cacoal. Contato: cacoal.pregoeiros@gmail.com, (69) 3443-8027. ENCERRADO."
 },
 "8c6a2a0e25ff8b32702d": {
  "objeto": "Chamamento Publico no 003/PMJ/2026 do Municipio de Jaru/RO (Secretaria Municipal de Agronegocio e Meio Ambiente - SEMEAGRO, processo 16098/PMJ/2025), nos termos da Lei 13.019/2014 (MROSC) e do Decreto 8.726/2016 - selecao de ASSOCIACAO RURAL PRIVADA, SEM FINS LUCRATIVOS, representativa de agricultores familiares, para celebracao de Acordo de Cooperacao destinado a recepcao, gestao e utilizacao de 01 distribuidor de calcario e fertilizante e 01 vagao forrageiro, oriundos do Convenio 352/2025.",
  "inicio": "2026-08-07",
  "fim": "2026-09-21",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/04279238000159/compras/2026/196/arquivos/2",
  "observacao": "*** EDITAL ABERTO nesta data (08/09/2026) - 13 dias restantes. OPORTUNIDADE VIVA. *** Municipio de Jaru/RO. Aviso oficial do municipio (hospedado no PNCP) lido: inscricoes 'de 07h:30min as 11h:30min e 13h:30min as 17h:30min, iniciando as 08h30min do dia 07 de agosto de 2026, finalizando as 08h30 do dia 21 de setembro de 2026'. LOCAL DA INSCRICAO: presencial na Superintendencia. Perfil exigido: associacao rural sem fins lucrativos representativa de agricultores familiares. Nao ha repasse em dinheiro - o objeto e a cessao de equipamentos agricolas (distribuidor de calcario e vagao forrageiro) por acordo de cooperacao. Portal do municipio: transparencia.jaru.ro.gov.br"
 },
