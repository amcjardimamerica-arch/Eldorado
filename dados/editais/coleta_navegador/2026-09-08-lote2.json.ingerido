 "fa8d9e9bfc9ccac034e2": {
  "objeto": "Edital de Chamamento Publico no 014/2026 de Manaus/AM (PNAB) - convocacao das entidades e coletivos culturais reconhecidos como Pontos de Cultura de relevancia para o municipio, listados no art. 2o, para apresentarem a documentacao necessaria a formalizacao de Termo de Fomento.",
  "inicio": "2026-02-13",
  "fim": "2026-03-10",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07074697000194/compras/2026/14/arquivos/1",
  "observacao": "Fundo Municipal de Cultura de Manaus. Lido no PDF do edital do proprio municipio (10p) hospedado no PNCP: os convocados devem comparecer a sede do Conselho Municipal de Cultura (Rua Bernardo Ramos, Centro) 'no periodo de 13/02/2026 a 10/03/2026, das 08:00 as 16h, para a entrega dos seguintes documentos'. ATENCAO ao enquadramento: NAO e chamada aberta - e convocacao de entidades ja listadas nominalmente no art. 2o do edital. So serve a quem ja e Ponto de Cultura reconhecido em Manaus. Recursos ate 31/03/2026. ENCERRADO."
 },
 "01efd9c4cbacbc782d98": {
  "objeto": "Edital de Chamamento Publico no 007/2024 de Alagoinhas/BA - Edital de Incentivo a Producao e Fruicao Artistica em Regioes Perifericas, Urbanas e Rurais e em Comunidades Tradicionais: concessao de apoio financeiro a acoes culturais nos termos da PNAB (Lei 14.399/2022) e da Lei 14.903/2024. Aberto a agente cultural que atua ou reside no municipio.",
