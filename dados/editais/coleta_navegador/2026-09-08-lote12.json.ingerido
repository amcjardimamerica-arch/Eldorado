 "ced063d82912665631c2": {
  "objeto": "Edital de Chamamento Publico no 03/2025/PMINN do Municipio de Itabaianinha/SE - formalizacao de parceria, mediante Termo de Colaboracao, com Organizacao da Sociedade Civil, visando a execucao complementar e colaborativa de atividades voltadas ao fortalecimento (area de educacao).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/13098181000182/compras/2025/247/arquivos/1",
  "observacao": "Municipio de Itabaianinha/SE (Praca Floriano Peixoto 27). Os dois documentos anexados ao registro do PNCP foram lidos - o edital (66p) e o aviso de chamamento. A varredura completa de datas NAO encontrou janela de apresentacao de propostas: so datas de leis e duas assinaturas (03/11/2025 e 02/12/2025). O edital publicado nao traz cronograma. Por isso inicio e fim ficam null. Curiosidade que merece conferencia: as duas assinaturas do mesmo processo tem quase um mes de diferenca, o que sugere republicacao."
 },
 "d6d7c11b64f398ad3612": {
  "objeto": "Edital no 001/2025 de Nossa Senhora do Socorro/SE - Edital de Fomento de Acoes Artisticas e Culturais, edicao PNAB (Lei 14.399/2022), para firmar Termo de Execucao Cultural. Aberto a residentes e pessoas juridicas domiciliadas no municipio; entre as categorias ha linha especifica para terreiros, casas ou centros religiosos (4 vagas de R$ 25.000,00).",
  "inicio": "2025-05-26",
  "fim": "2025-05-30",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/13128814000158/compras/2025/284/arquivos/1",
  "observacao": "Municipio de Nossa Senhora do Socorro/SE. Item 4.4 lido no PDF do edital do proprio municipio (57p, publicado no Diario Oficial edicao 1.243 de 23/05/2025) hospedado no PNCP: 'O periodo de inscricoes de candidaturas de propostas de projetos sera de 26 DE MAIO A 30 DE MAIO DE 2025', com atendimento das 8h as 17h e limite as 17h do dia 30/05. JANELA DE APENAS 5 DIAS, aberta 3 dias apos a publicacao - prazo materialmente muito curto para elaborar projeto. ENCERRADO."
 },
 "376797a4a12712fd398d": {
  "objeto": "Chamamento Publico da Secretaria Municipal de Comunicacao Social (SECOM) de Aracaju/SE - selecao de pessoas juridicas interessadas em ADQUIRIR COTAS DE PATROCINIO mediante aporte financeiro para a realizacao da 41a CORRIDA CIDADE DE ARACAJU.",
  "inicio": "2026-02-04",
  "fim": "2026-02-20",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/13128780003974/compras/2026/1/arquivos/1",
  "observacao": "*** NAO SERVE PARA CAPTACAO DE OSC: e o municipio VENDENDO cotas de patrocinio. *** Prefeitura de Aracaju/SE, SECOM. Localizei o registro pela busca do PNCP (o link capturado era do aracajucompras.se.gov.br). Item 1.3 lido no PDF do edital do proprio municipio (16p): 'O Requerimento para Participacao - Anexo I devera ser encaminhado, por meio eletronico, no periodo de 04 de fevereiro de 2026 a 20 de fevereiro de 2026, para o e-mail secom.daf@aracaju.se.gov.br'; documentacao e propostas de precos entregues ate 20/02/2026 na sede da SECOM. Contrato de patrocinio com termo final em 28/03/2026. Quem paga e o patrocinador. ENCERRADO."
 },
 "0aeca17ad40153d72098": {
  "objeto": "Edital de Chamamento no 003/2026/SMAS do Municipio de Aruja/SP (Secretaria de Assistencia Social) - Termo de Colaboracao para execucao do Servico de Protecao Social Especial de Alta Complexidade: Servico de Acolhimento Institucional para populacao adulta de ambos os sexos em situacao de rua.",
  "inicio": "2026-04-06",
  "fim": "2026-05-05",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/56901275000150/compras/2026/105/arquivos/1",
  "observacao": "Municipio de Aruja/SP. Anexo VIII (Cronograma de Prazos) lido no PDF do edital do proprio municipio (52p) hospedado no PNCP: 'Publicacao do Edital 02/04/2026; Periodo de Publicizacao 06/04/2026 a 05/05/2026 (30 dias antes das propostas); Prazo para o envio das Propostas pelas OSCs 05/05/2026; Sessao Publica de Abertura dos Envelopes 06/05/2026; avaliacao 06 a 08/05/2026; resultado preliminar 11/05/2026'. Adotei 06/04 como inicio (abertura da publicizacao) e 05/05 como limite de envio. RESSALVA: o documento se identifica como 'MINUTA - EDITAL' no cabecalho. Entrega em ENVELOPE. ENCERRADO."
 },
