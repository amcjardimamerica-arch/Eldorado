 },
 "77be3a1f9404f5b292f0": {
  "objeto": "Edital de Chamamento Publico 007/2026 (Lei 13.019/2014) - selecao de Organizacao da Sociedade Civil (OSC) para firmar Termo de Colaboracao com a Administracao Publica Municipal de Formosa/GO, visando ao fortalecimento das acoes dos projetos sociais. Termo de colaboracao com objetivo de fomento; valor maximo da parceria R$ 200.000,00.",
  "inicio": "2026-07-03",
  "fim": "2026-07-22",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/01738780000134/compras/2026/76/arquivos/1",
  "observacao": "Municipio de Formosa/GO, processo 2025037911, Secretaria Municipal de Governo. Lido no PDF do edital do proprio municipio (35p) hospedado no PNCP: 'Data de inicio e limite de entrega de propostas 03/07/2026 a 22/07/2026, de 08h00 as 11h00 e 13h00 as 17h00'; publicacao 02/07/2026; sessao publica de abertura 23/07/2026. Envio hibrido (presencial por protocolo geral). Edital ENCERRADO - o prazo terminou em 22/07/2026. Nota: o titulo capturado na base fala de 'projeto de investimento destinado a construcao' e o edital fala de fomento a projetos sociais; o objeto valido e o do edital."
 },
 "ba62bfc2d3ecc4281773": {
  "objeto": "Termos de Fomento",
  "inicio": null,
  "fim": null,
  "pagina_oficial": null,
  "observacao": "Nao e edital: goias.gov.br/cultura/termos-de-fomento e a pagina de termos JA celebrados por inexigibilidade — nao ha e nunca havera prazo de inscricao. Os editais reais do estado estao em goias.gov.br/cultura/pnab/edital-2026-pnab/ e fica.go.gov.br."
 },
 "f55515b0dd2abb47203c": {
  "objeto": "Edital de Chamamento Publico 09/2024 do Municipio de Planaltina/GO (Secretaria de Esporte e Lazer) - selecao de propostas apresentadas por Organizacoes da Sociedade Civil que visem a execucao de atividades esportivas e gestao de escolinha/campo, com recursos de investimento do esporte e lazer.",
  "inicio": "2024-08-07",
  "fim": "2024-08-15",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/01740422000166/compras/2024/63/arquivos/1",
  "observacao": "Municipio de Planaltina/GO. Localizei o registro pela busca do PNCP (o link capturado apontava para o Portal de Compras Publicas, plataforma privada) e li o PDF do edital do proprio municipio (37p): 'DATA E HORA DE INICIO DAS PROPOSTAS: 08:00h do dia 07/08/2024; DATA E HORA FINAL DAS PROPOSTAS: 23:59h do dia 15/08/2024; DATA DE ABERTURA DAS PROPOSTAS - SESSAO PUBLICA: 10:00h do dia 20/08/2024'. Prazo de impugnacao coincide com o fim das propostas (15/08). Envio pelo www.portaldecompraspublicas.com.br. Janela de 9 dias. ENCERRADO. Contato: (61) 3637-1273."
 },
 "5456e0e05221a7c52df8": {
  "objeto": "Edital de Chamamento Publico no 01/2024 - premiacao para festejos populares que acontecem no minimo ha 5 anos no Municipio de Cavalcante/GO, premiacao para agentes culturais com recursos da PNAB. Podem se inscrever agentes culturais com contribuicao artistica ou cultural no municipio ha pelo menos 2 anos.",
  "inicio": "2024-11-02",
  "fim": "2024-11-25",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/51110756000124/compras/2024/1/arquivos/1",
  "observacao": "Fundo Municipal de Cultura de Cavalcante/GO. Item 2.4 lido no PDF do edital do proprio municipio (10p) hospedado no PNCP: 'Prazo de inscricao: De 00 horas do dia 02/11/2024 ate 23h59 horas do dia 25/11/2024'. Inscricao por formulario Google (pessoa fisica e pessoa juridica). O resultado tinha validade ate 31/12/2024. Edital ENCERRADO."
 },
 "5b991f651a1905c579de": {
  "objeto": "Edital de Chamamento Publico no 003/2023 do Municipio de Alvorada do Norte/GO - selecao de agentes culturais de AUDIOVISUAL que tenham prestado relevante contribuicao ao desenvolvimento artistico ou cultural do municipio (Lei Paulo Gustavo).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/02367597000132/compras/2023/423/arquivos/1",
  "observacao": "Municipio de Alvorada do Norte/GO. Os TRES documentos anexados ao registro do PNCP sao acessorios - 'Errata 1 do Edital 003-2023 Producao Audiovisual', 'COMUNICADO EDITAL 003-2023' e 'ANEXOS I ao VI - RETIFICADOS'. O EDITAL PRINCIPAL nao foi anexado ao registro; o que se le e o Anexo I (categorias e recursos). Sem o edital, nao ha janela de inscricao verificavel - inicio e fim ficam null. PISTA: o metadado do PNCP declara 13/11/2023 a 19/12/2023. Contato: adm@alvoradadonorte.go.gov.br, (62) 3421-1369. ENCERRADO (2023). Nota: a existencia de errata e de anexos retificados indica que o edital foi alterado apos a publicacao - a janela pode ter mudado."
 },
 "db310a0fc81e8c860adc": {
  "objeto": "Edital de Chamamento Publico no 004/2023 do Municipio de Alvorada do Norte/GO (Inexigibilidade 011/2023, processo administrativo 516/2023) - selecao de agentes culturais que tenham prestado relevante contribuicao ao desenvolvimento artistico ou cultural do municipio, nas DEMAIS AREAS DA CULTURA. Premio de natureza de premiacao cultural (Lei Paulo Gustavo, Decreto 11.525/2023).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/02367597000132/compras/2023/424/arquivos/1",
  "observacao": "Municipio de Alvorada do Norte/GO. Os documentos anexados (comunicado + edital das demais areas) foram lidos: o objeto esta claro, mas a varredura completa de datas NAO recuperou janela de inscricao - so a data de assinatura do edital (13/11/2023) e datas de decretos. Por isso inicio e fim ficam null. PISTA: o metadado do PNCP declara 13/11/2023 a 19/12/2023, mesma janela do edital 003/2023 do mesmo municipio (item 5b991f65) - conferir com a Secretaria Municipal de Educacao e Cultura. Contato: adm@alvoradadonorte.go.gov.br, (62) 3421-1369. ENCERRADO (2023)."
 },
