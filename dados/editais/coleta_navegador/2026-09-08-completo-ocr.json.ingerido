 "95888ca3f2ff49ada9b4": {
  "objeto": "Chamamento Publico 002/2026 do Municipio de Potim/SP - selecao de Organizacao da Sociedade Civil (OSC) para a implantacao, operacionalizacao e gestao de UNIDADE DE ATENDIMENTO MEDICO-VETERINARIO PUBLICO no municipio.",
  "inicio": "2026-03-05",
  "fim": "2026-04-16",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/65042855000120/compras/2026/22/arquivos/1",
  "observacao": "Municipio de Potim/SP ('Terra do Artesanato'). Cronograma lido no PDF do aviso/edital do proprio municipio (59p) hospedado no PNCP: 'Publicacao do Edital 05/03/2026 a 16/04/2026; Envio de propostas pelas OSCs interessadas 05/03/2026 a 16/04/2026; Sessao publica de abertura das propostas 17/04/2026; Avaliacao das propostas e documentos de habilitacao a partir de 17/04/2026'. Janela ampla (42 dias). Perfil especifico: OSC capaz de operar clinica veterinaria publica - bom encaixe para entidade de causa animal com estrutura. ENCERRADO. Contato: licitacao@potim.sp.gov.br, (12) 3112-xxxx."
 },
 "a05a1fc4d54dee02d624": {
  "objeto": "Chamamento Publico para celebracao de CONTRATO DE GESTAO, tendo por objeto o gerenciamento, a operacionalizacao e a execucao de acoes e servicos de saude.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/45152139000199/compras/2026/49/arquivos/1",
  "observacao": "O unico documento anexado ao registro do PNCP e 'ANEXOS_I_-_PNCP.pdf', que na verdade e um pacote compactado sem nenhum PDF dentro (a abertura mostra so partes de um documento Office: [Content_Types].xml, _rels/.rels, word/...) e cujo conteudo aparente e apenas 'ESTIMATIVA DO VALOR DE CONTRATACAO' - ou seja, um ANEXO, nao o edital. O edital em si nao foi anexado ao registro. Sem fonte, inicio e fim ficam null. Nota de enquadramento: contrato de gestao com OS de saude e instrumento de gestao de servico publico, com exigencia de qualificacao previa como Organizacao Social - fora do perfil de fomento a projeto."
 },
 "aa9366fa9ddcbbd6d421": {
