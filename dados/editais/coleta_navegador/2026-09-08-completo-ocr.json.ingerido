 "31b8a937a989d196a8b7": {
  "objeto": "Chamada Publica no SS-CH001/2025 da Secretaria de Saude de Nova Russas/CE - chamamento publico de entidades privadas, sem fins lucrativos, interessadas em se qualificarem como ORGANIZACAO SOCIAL na area de saude, para habilitacao para eventual e futuro gerenciamento.",
  "inicio": "2025-01-31",
  "fim": "2025-03-06",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07993439000101/compras/2025/16/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO: nao e edital de fomento a OSC. *** E qualificacao previa como Organizacao Social de saude - habilitacao para eventual e futuro gerenciamento, sem repasse vinculado nem projeto. Lido no PDF do edital do proprio municipio (17p) + aviso + adendo hospedados no PNCP: recebimento de documentos 'a partir do dia 31 de janeiro de 2025 a 24 de fevereiro de 2025' na Rua Padre Francisco Rosa 1388, Centro; o ADENDO do mesmo registro prorrogou o recebimento 'para ate o dia 06 de marco de 2025, de 08h00min as 14h00min' - e essa a data valida. Edital ENCERRADO."
 },
 "43ec6258b8523a140c08": {
  "objeto": "Edital de Chamamento Publico no ST-CP001/2026 de Senador Pompeu/CE - selecao de Organizacoes da Sociedade Civil (OSC) interessadas em celebrar Termo de Fomento para execucao de acoes voltadas a promocao, protecao e defesa dos direitos de criancas e adolescentes, em consonancia com o ECA e com as diretrizes estadual e municipal. Recursos do Fundo Municipal dos Direitos da Crianca e do Adolescente (FIA).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07728421000182/compras/2026/59/arquivos/1",
  "observacao": "Municipio de Senador Pompeu/CE (COMDICASP / Secretaria do Trabalho). O PDF do edital (46p) hospedado no PNCP e um DIGITALIZADO DE BAIXA QUALIDADE: a extracao de texto sai corrompida ('Ponnpeu', 'setennbro', 'dejulho') e NAO recupera nenhuma data de inscricao - so as datas das leis citadas e a assinatura em 02/06/2026. Por isso inicio e fim ficam null em vez de uma data plausivel. PISTA para conferencia: o metadado do PNCP declara janela de 03/06/2026 a 06/07/2026 - e metadado, nao o edital, entao precisa ser confirmado com o municipio antes de virar dado. Edital provavelmente encerrado."
 },
 "caa19170eb41534c9368": {
  "objeto": "Edital de Chamamento Publico no 005/2025-CP do Municipio de Ocara/CE (Secretaria de Saude) - QUALIFICACAO de entidades como ORGANIZACAO SOCIAL, nos termos da Lei Municipal 1.235/2025 (de 07/03/2025, alterada pela Lei Municipal 1.243/2025 de 11/04/2025) e do Decreto Municipal 026/2025-GAB/P (de 14/05/2025).",
  "inicio": null,
  "fim": "2025-10-16",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/12459616000104/compras/2025/143/arquivos/1",
  "observacao": "*** RECUPERADO POR OCR - E CORRIGE O ENQUADRAMENTO DESTE ITEM. *** Municipio de Ocara/CE, Avenida Coronel Joao Felipe 341, Centro. Os tres documentos anexados ao registro sao imagens digitalizadas sem camada de texto (por isso o item estava integralmente null). O OCR das duas primeiras paginas revelou que o objeto NAO e selecao de OSC para termo de fomento, como sugeria o titulo capturado, mas QUALIFICACAO PREVIA COMO ORGANIZACAO SOCIAL pela Secretaria de Saude - portanto fora do perfil de fomento a projeto. Cronograma lido: 'PRAZO PARA PEDIDOS DE ESCLARECIMENTO E/OU IMPUGNACAO 13/10/2025; PRAZO PARA REQUERER A QUALIFICACAO COMO ORGANIZACAO SOCIAL 16/10/2025 as 9h; DATA PREVISTA PARA DIVULGACAO DAS ENTIDADES QUALIFICADAS 21/10/2025; RECURSO 22 a 23/10/2025; CONTRARRAZOES 24 a 27/10/2025'. O prazo-limite (16/10/2025) fica gravado; nao ha data de abertura no cronograma, por isso inicio fica null. Havia pedido de impugnacao anexado ao registro, coerente com o prazo de esclarecimento de 13/10. ENCERRADO."
 },
 "d19c6f466e3d3c7c32d4": {
  "objeto": "Edital de Chamamento Publico no 001/2024 do Municipio de Acopiara/CE - abertura, em carater emergencial, do processo de QUALIFICACAO de entidades privadas sem fins lucrativos como ORGANIZACAO SOCIAL na area da saude, visando a futura celebracao de contrato de gestao.",
  "inicio": "2024-10-16",
  "fim": "2024-10-31",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07847379000119/compras/2024/118/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO: nao e edital de fomento a OSC. *** E qualificacao previa como Organizacao Social de saude (Lei Federal 9.637/98, Decreto Municipal 0253/2024), sem repasse vinculado nem projeto. Prazo lido no PDF do aviso oficial do municipio (8p) hospedado no PNCP: entrega na sede da Prefeitura, Av. Jose Marques Filho 600, Centro, 'entre os dias 16/10/2024 a 31/10/2024'. Documento assinado em 14/10/2024. DIVERGENCIA: o metadado do PNCP registra 21/10 a 31/10/2024 - vale o edital. Edital ENCERRADO."
 },
 "dc73999357ed4e37d07f": {
