 },
 "898d930ce5601d1616e3": {
  "objeto": "Abertura de edital de chamamento publico (Lei 13.019/2014) para celebracao de parceria com organizacoes da sociedade civil - Secretaria Municipal de Esportes e Desenvolvimento Social de Bento Goncalves/RS.",
