 "832b4ebf5f1b167a198e": {
  "objeto": "Edital de Chamamento Publico no 112/2024 do Municipio de Ribeirao das Neves/MG - premiacao de agentes culturais que tenham prestado relevante contribuicao ao desenvolvimento artistico e cultural do municipio (Premiacoes Culturais, Artisticas, Cientificas e Desportivas).",
  "inicio": "2024-10-09",
  "fim": "2024-10-15",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/18314609000109/compras/2024/48/arquivos/1",
  "observacao": "Municipio de Ribeirao das Neves/MG, Secretaria Municipal de Esporte e Cultura. Item 2.4 lido no PDF do edital do proprio municipio (34p) hospedado no PNCP: 'Prazo de inscricao: De 08 horas do dia 09/10/2024 ate 23:59 horas do dia 15/10/2024'. Confere com o cronograma ('Periodo de Inscricao 09/10/2024 a 15/10/2024, Online e Presencial de 08hs as 17hs'), divulgacao dos inscritos 16/10/2024 e analise 18 a 24/10/2024. Publicacao em ammlicita.org.br, diariomunicipal.com.br e ribeiraodasneves.mg.gov.br. ENCERRADO."
 },
 "d6ff07772a8525e4a45c": {
  "objeto": "Edital de Chamamento Publico no 116/2024 do Municipio de Ribeirao das Neves/MG - selecao de espacos, ambientes e iniciativas artistico-culturais para receber SUBSIDIO PARA MANUTENCAO, com recursos da Lei Federal 14.399/2022 (PNAB). Aberto a agentes culturais que constituem espacos e iniciativas artistico-culturais localizados no municipio.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/18314609000109/compras/2024/50/arquivos/1",
  "observacao": "Municipio de Ribeirao das Neves/MG (Processo 133/2024). O PDF do edital (52p) foi lido integralmente. O item 1.4 'Prazo de inscricao' NAO fixa data: diz apenas '1.4.1 As inscricoes serao realizadas conforme orientacoes descritas no item 3 deste edital', e o item 3 tambem nao traz janela - o unico anexo com datas seria o 'Anexo X - Cronograma de Acoes', que nao esta no documento anexado. Varredura completa de datas no texto: so datas de leis e a assinatura em 30/09/2024. Por isso inicio e fim ficam null - a omissao e do proprio edital. PISTA: o metadado do PNCP nao declara janela. Comparar com o edital 112/2024 do mesmo municipio (item 832b4ebf), que teve inscricoes de 09 a 15/10/2024."
 },
