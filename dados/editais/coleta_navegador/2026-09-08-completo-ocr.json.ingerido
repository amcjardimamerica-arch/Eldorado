 "30ec946c0da038e039cc": {
  "objeto": "Edital de Chamamento Publico no CP-001/2024-PMI do Municipio de Ibiapina/CE - celebracao de Termo de Colaboracao cujo objeto e a concessao dos servicos de apoio a administracao publica municipal para a criacao, execucao e monitoramento de PROGRAMA DE CAPACITACAO, visando a melhoria da qualificacao tecnica da comunidade local. Valor total de referencia: R$ 7.486.575,00 (estimativa anual, 11 meses de aplicacao).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07523186000102/compras/2025/2/arquivos/1",
  "observacao": "Municipio de Ibiapina/CE. Localizei o registro pela busca do PNCP (o link capturado era do Licita Mais Brasil, plataforma privada com login). O PDF do edital (64p) foi lido integralmente: o item 7.5 remete ao 'cronograma previsto no item 9 do Edital', mas a tabela do item 9 NAO saiu na camada de texto e a varredura completa de datas nao recuperou nenhuma janela - so datas de leis e a Portaria 205-A de 17/12/2024 que designou a comissao. Por isso inicio e fim ficam null. Entrega em envelope, sessao publica na sala da Comissao de Contratacao (Rua Deputado Alvaro Soares s/n, Centro). Nota do proprio edital: o municipio publica por afixacao na sede da Prefeitura por nao haver imprensa oficial local - o que explica a dificuldade de rastrear prazos."
 },
 "f1ca92b53138bf67e586": {
  "objeto": "Edital de Chamamento Publico no 001/2025/SMC-CHP da Secretaria de Cultura, Turismo, Esporte e Juventude de Carire/CE - selecao de organizacao da sociedade civil sem fins lucrativos para firmar parceria (Termo de Colaboracao) em regime de mutua colaboracao, com transferencia de recursos financeiros. Projeto REISADO.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/07598600000142/compras/2025/4/arquivos/1",
  "observacao": "Municipio de Carire/CE. O PDF do edital (40p, marcado como 'PESQUISAVEL') foi lido integralmente e NAO contem prazo de inscricao nem cronograma: traz objeto, vedacoes, minuta do termo e vigencia ate 31/12/2025, mas nenhuma janela de apresentacao de propostas. Por isso inicio e fim ficam null - a omissao e do proprio edital, nao da leitura. PISTA para conferencia: o metadado do PNCP declara 03/01/2025 a 07/01/2025 (janela de 5 dias, corridos no inicio do ano) - conferir com o municipio, porque prazo tao curto e materia de impugnacao. ENCERRADO."
 },
 "217ba2edfd96404374b3": {
  "objeto": "Chamamento Publico do Instituto Brasileiro de Museus (IBRAM) - selecionar e premiar 40 (quarenta) acoes de museologia social, realizadas por pontos de memoria e iniciativas de museologia social (Concurso 00001/2023, UASG 423002).",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/10898596000142/compras/2023/51/arquivos/1",
  "observacao": "IBRAM/DF. Localizei o registro pela busca do PNCP (o link capturado era do Comprasnet). O UNICO documento anexado ao registro e a 'Relacao de Itens' do Concurso 00001/2023 (7p) - lista de itens e valores (premios de R$ 40.000,00 por acao, entrega em Brasilia/DF, emitida em 05/06/2023), NAO o edital. Sem o edital nao ha janela de inscricao verificavel: inicio e fim ficam null. PISTA: o objeto corresponde ao Premio Pontos de Memoria do Ibram, edicao 2023 - o edital e as noticias oficiais estao no portal gov.br/museus, e ha registro de que as inscricoes daquela edicao foram PRORROGADAS (noticia oficial de 07/08/2023), o que significa que qualquer data precisa ser conferida na versao final. Como e edital de 2023, o valor e historico."
 },
 "c398fe0faee0394d5113": {
  "objeto": "Chamamento Publico do CONFEA (Conselho Federal de Engenharia e Agronomia) - promover chamamento de pessoas fisicas ou juridicas de direito privado ou publico para firmar acordos de patrocinio, nao exclusivos, para a 81a Semana Oficial da Engenharia e Agronomia (SOEA), conforme cotas de patrocinio do Anexo 4.",
  "inicio": null,
  "fim": "2026-06-19",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/33665647000191/compras/2026/38/arquivos/1",
  "observacao": "*** NAO SERVE PARA CAPTACAO DE OSC. *** E o Confea BUSCANDO PATROCINADOR para seu evento (recurso entrando no conselho), nao repassando recurso a entidade. Item 2.4 lido no PDF oficial do Confea (Midia Kit da 81a SOEA, 37p) hospedado no PNCP: 'As propostas deverao ser enviadas da data da publicacao desse edital ate 19 de junho de 2026'. Como o inicio e 'a data da publicacao' sem data expressa no trecho, inicio fica null. ENCERRADO."
 },
 "4c33635685d7c762cedb": {
  "objeto": "Edital de Selecao Publica no 001/2024 do Municipio de Itapemirim/ES - selecao de Entidade Fechada de Previdencia Complementar (EFPC) para administracao de plano de beneficios previdenciarios dos servidores publicos da administracao direta e indireta.",
  "inicio": null,
  "fim": "2024-04-26",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/27174168000170/compras/2024/284/arquivos/1",
  "observacao": "*** NAO SERVE PARA CAPTACAO DE OSC. *** O titulo capturado na base diz 'selecao de pessoa juridica de direito privado, sem fins lucrativos' e por isso o item entrou na lista, mas o edital lido (22p, hospedado no PNCP) mostra que a pessoa juridica em questao e uma ENTIDADE FECHADA DE PREVIDENCIA COMPLEMENTAR para administrar o plano de previdencia dos servidores - nao ha fomento nem repasse a OSC. Cronograma: publicacao 05/04/2024, retificacao 18/04/2024, 'Envio e recebimento das documentacoes de habilitacao e das propostas tecnicas pelas Entidades interessadas: Ate 26/04/2024'. Nao ha data de inicio fixada, por isso inicio fica null. ENCERRADO."
 },
 "11768ed9d6ef89878efe": {
  "objeto": "Edital de Chamamento Publico no 04/2026 do Municipio de Governador Luiz Rocha/MA - concessao de apoio financeiro a acoes culturais nos termos da PNAB (Lei 14.399/2022) e da Lei 14.903/2024, para firmar Termo de Execucao Cultural. Aberto a agente cultural pessoa fisica e a grupos e coletivos que atuem e residam no municipio.",
  "inicio": "2026-04-23",
  "fim": "2026-04-29",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/01578554000133/compras/2026/11/arquivos/1",
  "observacao": "Municipio de Governador Luiz Rocha/MA. Item 2.4 lido no PDF do edital do proprio municipio (30p) hospedado no PNCP: 'Prazo de inscricao: 23 de abril ate 29 de abril de 2026'. DIVERGENCIA relevante: o metadado do PNCP declara 05/05/2026 a 13/05/2026 - vale o edital (23 a 29/04). O cronograma do edital preve divulgacao das inscricoes admitidas em 14/05/2026. Janela de apenas 7 dias. ENCERRADO."
 },
 "e8de25d724d1de2c80b0": {
  "objeto": "Edital de Chamamento Publico no 001/2026-SEMUS/PMPR do Municipio de Paulo Ramos/MA - selecao de Organizacao da Sociedade Civil (Lei 13.019/2014) para celebracao de Termo de Fomento visando a execucao de acoes especializadas em OFTALMOLOGIA (consultas, exames, laudos, prescricao optica e fornecimento de oculos), no ambito do Programa Mais Acesso a Especialistas (PMAE) / Oferta de Cuidados Integrados (OCI), em regime de mutua cooperacao com a Administracao Publica Municipal.",
  "inicio": null,
  "fim": "2026-07-03",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/06029524000191/compras/2026/32/arquivos/1",
  "observacao": "Municipio de Paulo Ramos/MA (SEMUS). Item 3 lido no PDF do documento oficial do municipio (30p) hospedado no PNCP: entrega presencial em dias uteis, exceto pontos facultativos, 'ou por meio eletronico atraves do endereco: licitacao@pauloramos.ma.gov.br, ate o dia 03 de julho de 2026'. Edital assinado em 29/05/2026 e vigente a partir da publicacao no Diario Oficial do Municipio - nao ha data de abertura expressa, por isso inicio fica null. Aceita envio por E-MAIL. Confere com o metadado do PNCP (02/06 a 03/07/2026). Perfil especifico: entidade com capacidade de operar servico oftalmologico. ENCERRADO."
 },
 "d68b52c19517b5fe511c": {
  "objeto": "Edital de Credenciamento no 003/2024 do Municipio de Caxias/MA - formalizacao de termo de colaboracao de finalidade de interesse publico e reciproco que envolve a execucao do gerenciamento, operacionalizacao e execucao das acoes e servicos de saude na MATERNIDADE CARMOSINA COUTINHO.",
  "inicio": "2024-07-05",
  "fim": "2024-07-22",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/06082820000156/compras/2024/33/arquivos/1",
  "observacao": "Municipio de Caxias/MA. Localizei o registro pela busca do PNCP (o link capturado apontava para o Portal de Compras Publicas). Lido no PDF do edital do proprio municipio (65p): envio da documentacao e proposta pelo portal www.portaldecompraspublicas.com.br - 'O prazo para envio se iniciara dia 05/07/2024 e se encerrara dia 22/07/2024, as 18h:00min'. ATENCAO AO ENQUADRAMENTO: e gestao de maternidade (servico de saude de alta complexidade), instrumento tipico de OS/OSCIP com estrutura hospitalar - nao e fomento a projeto. ENCERRADO. Contato: (99) 3521-3630."
 },
