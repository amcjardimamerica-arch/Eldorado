{
 "a36ee8a76017ea615080": {
  "objeto": "EDITAL 04 - Fomento e premiacao para agentes culturais do Municipio de Rondonopolis/MT, com recursos do Governo Federal por meio da Politica Nacional Aldir Blanc II de Fomento a Cultura (Lei 14.399/2022). Licitacao 429/2024, valor estimado R$ 113.881,42.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://transparencia.rondonopolis.mt.gov.br/rondonopolis/licitacoes/licitacao?id=29309",
  "observacao": "Municipio de Rondonopolis/MT. Lido no PORTAL OFICIAL de transparencia do municipio (dominio proprio rondonopolis.mt.gov.br), aberto com navegador real - o portal e SPA e nao abre por leitura automatizada. O portal informa: Licitacao 429/2024, processo 429/2024, modalidade INEXIGIBILIDADE, situacao HOMOLOGADA, data de abertura e de realizacao 24/12/2024, valor estimado R$ 113.881,42. O portal NAO disponibiliza o PDF do edital na listagem (a aba 'Publicacao de edital' nao expoe arquivo), por isso nao ha janela de inscricao verificavel: inicio e fim ficam null. ATENCAO AO ENQUADRAMENTO: modalidade inexigibilidade e situacao homologada indicam premiacao ja concedida, sem disputa aberta. Contato: ouvidoria@rondonopolis.mt.gov.br, (66) 3411-3500."
 },
 "cfa2bfd4a77cf4ce804e": {
  "objeto": "Concurso no 1/2025 do Municipio de Paranatinga/MT (processo 28/2025) - selecao de entidade de direito privado, sem fins lucrativos, qualificada como OSCIP, para celebrar Termo de Parceria visando o fomento e realizacao de atividades de interesse publico no desenvolvimento de projetos vinculados na AREA DE SAUDE (Lei Federal 9.790/1999, Decreto 3.100/1999, Lei Estadual MT 11.082/2020). Valor estimado R$ 3.673.772,92; homologado R$ 3.573.283,72.",
  "inicio": null,
  "fim": "2025-05-30",
  "pagina_oficial": "https://transparencia.agilicloud.com.br/prefparanatinga-mt/licitacoes/licitacao?id=2573",
  "observacao": "Municipio de Paranatinga/MT. Lido no portal oficial de transparencia do municipio (plataforma AgiliBlue, aberto com navegador real - e SPA e nao abre por leitura automatizada). O portal informa: Concurso 1/2025, processo 28/2025, situacao HOMOLOGADA, data de abertura e de realizacao 30/05/2025. Formato de concurso de projetos com sessao unica: nao ha janela de inscricao, so a data da sessao - inicio fica null. Exige qualificacao previa como OSCIP. Valor alto (R$ 3,57 milhoes homologados). ENCERRADO."
 },
 "4c94a13f418fba0d0715": {
  "objeto": "Concurso no 1/2026 do Municipio de Nobres/MT (processo 76/2026) - selecao de entidade de direito privado, sem fins lucrativos, qualificada como OSCIP, para celebrar Termo de Parceria visando o fomento e realizacao de atividades de interesse publico no desenvolvimento de projetos vinculados nas areas de SAUDE E ASSISTENCIA SOCIAL (Lei Federal 9.790/1999, Decreto 3.100/1999, Lei Estadual MT 11.082/2020). Valor estimado R$ 15.622.616,40.",
  "inicio": null,
  "fim": "2026-09-02",
  "pagina_oficial": "https://transparencia.nobres.mt.gov.br/prefnobres-mt/licitacoes/licitacao?id=5517",
  "observacao": "Municipio de Nobres/MT. Lido no PORTAL OFICIAL de transparencia do municipio (dominio proprio nobres.mt.gov.br), aberto com navegador real. O portal informa: Concurso 1/2026, processo 76/2026, situacao EM ANDAMENTO, data de abertura 02/09/2026, valor estimado R$ 15.622.616,40 - o maior valor de toda a base. Formato de concurso com sessao unica em 02/09/2026 (seis dias antes desta verificacao), por isso fim = 02/09/2026 e inicio null. 'Em andamento' significa que o processo esta na fase de julgamento, NAO que as propostas seguem sendo recebidas. Exige qualificacao previa como OSCIP em saude/assistencia social. Vale acompanhar o resultado: contrato dessa ordem costuma gerar chamamentos subsequentes."
 },
 "5865b8b689804b8e557e": {
  "objeto": "Selecao de entidade de direito privado, sem fins lucrativos, qualificada como Organizacao da Sociedade Civil de Interesse Publico (OSCIP) - Municipio de Nova Ubirata/MT.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/app/editais/03238862000145",
  "observacao": "Municipio de Nova Ubirata/MT. O link capturado (transparencia.agilicloud.com.br/novaubirata/...) NAO EXISTE MAIS: abri com navegador real e a plataforma AgiliBlue devolve o seletor de entes, e Nova Ubirata nao consta da lista de tenants - o municipio saiu da plataforma ou mudou o slug. Sem portal e sem registro localizavel, nao ha objeto detalhado nem prazo verificaveis: inicio e fim ficam null. Nota: o titulo e praticamente identico aos itens cfa2bfd4 (Paranatinga) e 4c94a13f (Nobres) - e o mesmo modelo de concurso OSCIP usado por varios municipios de MT, o que sugere ser tambem concurso de projetos com sessao unica e exigencia de qualificacao previa como OSCIP."
 },
 "eaa12d99fc473fb7ac68": {
  "objeto": "Termo de Parceria com Organizacao da Sociedade Civil de Interesse Publico (OSCIP) para realizacao de atividades, eventos, consultoria, servicos e assessoria de interesse publico, atraves do desenvolvimento, acompanhamento e execucao de programas de governo - area da Saude. Municipio de Vila Rica/MT.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/03238862000145/compras/2025/97/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO. *** Municipio de Vila Rica/MT. Os documentos anexados ao registro (53p e 41p) sao digitalizacoes de qualidade muito baixa - a extracao de texto sai corrompida e ilegivel em boa parte. O que se recupera com seguranca mostra que o conteudo NAO e um edital aberto: sao demonstrativos de pagamento e prestacao de contas de um Termo de Parceria JA CELEBRADO ('REFERENTE AO TERMO 10/2024, PERIODO: 01/10/2024 a 31/10/2024', com nome de entidade e dotacao). Ou seja, e execucao de parceria vigente, nao chamada publica. inicio e fim ficam null porque nao existe fase de inscricao. Recomendacao: remover do funil."
 },
 "f23f77917aa8ab75ca26": {
  "objeto": "Edital PNAB Belterra Ciclo 2 (Secretaria Municipal de Industria e Comercio, Cultura e Turismo - SEMICULT, Belterra/PA) - selecao de projetos para firmar Termo de Execucao Cultural com recursos da Politica Nacional Aldir Blanc de Fomento a Cultura.",
  "inicio": "2026-06-23",
  "fim": "2026-07-08",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/01614112000103/compras/2026/45/arquivos/1",
  "observacao": "Municipio de Belterra/PA. Item 2.3 lido no PDF do edital do proprio municipio (14p) hospedado no PNCP: 'Prazo de inscricao: Das 00h e 01m do dia 23 de junho de 2026 ate as 23h e 59m do dia 08 de julho de 2026', inscricoes exclusivamente online. O edital ainda oferecia plantao tira-duvidas para apoio a escrita de projetos (15 a 30/06/2026 online e atendimento presencial em 27/06) - detalhe util como referencia de boa pratica. Recursos da etapa de selecao 15 a 17/07/2026. ENCERRADO. Contato: semicult@belterra.pa.gov.br."
 },
 "b1b9f55f9e5624abd95e": {
  "objeto": "Edital de Credenciamento no 87/2026 da Fundacao Municipal de Saude de Teresina/PI - credenciamento para selecao de pessoas juridicas de natureza privada, com ou sem fins lucrativos, para contratacao de servicos ambulatoriais.",
  "inicio": "2026-08-03",
  "fim": "2026-08-17",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/05522917000170/compras/2026/140/arquivos/1",
  "observacao": "*** ATENCAO AO ENQUADRAMENTO: nao e fomento. *** Fundacao Municipal de Saude de Teresina/PI (processo 00045.064565/2025-47, UASG 927337). E CONTRATACAO DE SERVICOS ambulatoriais mediante credenciamento, com pagamento por producao - a entidade sem fins lucrativos entra como prestadora de servico, nao como beneficiaria de fomento. Item 4 lido no PDF do edital (103p) hospedado no PNCP: 'Disponibilidade do Edital: 03/08/2026' e recebimento das documentacoes ate 'o dia 17 de agosto de 2026'. Assinado em 27/07/2026. ENCERRADO."
 },
 "52aae9ce41ad52f83809": {
  "objeto": "Edital de Chamamento Publico no 011/2024-SEMTUDEC do Municipio de Floriano/PI - pactuacao de Termo de Colaboracao entre a Secretaria Municipal de Turismo e Desenvolvimento Economico e organizacoes da sociedade civil, para consecucao de finalidades de interesse publico com transferencia de recursos financeiros.",
  "inicio": "2024-11-01",
  "fim": "2024-11-06",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/06554067000154/compras/2024/108/arquivos/1",
  "observacao": "Municipio de Floriano/PI (SEMTUDEC). Cronograma lido no PDF do edital do proprio municipio (36p) hospedado no PNCP: publicacao do edital 31/10/2024; 'RECEBIMENTO DAS PROPOSTAS: 01 de novembro de 2024 a 06 de novembro de 2024'; divulgacao do resultado 07/11/2024; prazo para recurso 08 a 12/11/2024; resultado final 13/11/2024. Janela de apenas 6 dias, incluindo fim de semana. Contato: semtudec@floriano.pi.gov.br. ENCERRADO."
 },
 "023bbe9cd308edd98a3d": {
  "objeto": "Edital de Chamamento Publico no 027/2024 do Municipio de Prudentopolis/PR (Inexigibilidade 90091/2024, Processo Licitatorio 315/2024) - premiacao por trajetoria cultural: premiacao para agentes culturais que tenham prestado relevante contribuicao ao desenvolvimento artistico ou cultural do municipio.",
  "inicio": "2024-10-03",
  "fim": "2024-10-25",
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/77003424000134/compras/2024/325/arquivos/1",
  "observacao": "Municipio de Prudentopolis/PR. Prazo lido no PDF do edital do proprio municipio (14p) hospedado no PNCP: 'Do dia 03 de outubro de 2024 ate 08h30min do dia 25 de outubro de 2014'. ATENCAO: o edital tem ERRO DE DIGITACAO no ano final - escreve '2014' onde e 2024; adotei 25/10/2024, coerente com a vigencia do edital ate 31/12/2024 e com o inicio em 03/10/2024. Contato: cultura@prudentopolis.pr.gov.br, 0800 808 0130 ramal 8073. ENCERRADO."
 },
 "14a08a92997115da8279": {
  "objeto": "Edital de Chamamento Publico no 013/2025 do Municipio de Ipora/PR (Inexigibilidade 017/2025) - selecao de projetos culturais com recursos da Politica Nacional Aldir Blanc de Fomento a Cultura (PNAB, Lei 14.399/2022). Aberto a agentes culturais residentes na macrorregiao da AMERIOS, CONCAM e AMUSEP ha pelo menos 2 anos; execucao em ate 6 meses.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/75738484000170/compras/2025/72/arquivos/1",
  "observacao": "Municipio de Ipora/PR. O PDF do edital (11p) hospedado no PNCP foi lido integralmente e NAO fixa datas: o item 2.4 diz apenas 'As inscricoes estarao abertas por 15 dias uteis, a contar dois dias apos a publicacao deste edital, atraves do Formulario https://forms.gle/3NM1EtjhrJbRkPQz8'. Como o prazo e relativo e depende de contagem de dias uteis a partir de uma publicacao cuja data nao consta do documento, NAO calculei a data - inicio e fim ficam null, conforme a regra de nunca estimar. Para fechar este item basta a data de publicacao no Diario Oficial do municipio."
 },
 "244e3090efac17f5c82b": {
  "objeto": "Edital de Chamamento Publico no 003/2025 do Municipio de Campo Mourao/PR (Secretaria de Assistencia Social e Conselho Municipal dos Direitos da Crianca e do Adolescente) - recepcao e selecao de propostas de Organizacao da Sociedade Civil visando a celebracao de parceria por meio de Termo de Fomento.",
  "inicio": null,
  "fim": null,
  "pagina_oficial": "https://pncp.gov.br/pncp-api/v1/orgaos/75904524000106/compras/2025/323/arquivos/1",
  "observacao": "Municipio de Campo Mourao/PR (processo administrativo 346, processo digital 37035/2025). O PDF do edital (15p) hospedado no PNCP foi lido integralmente e a varredura completa de datas nao encontrou NENHUMA janela de apresentacao de propostas - so datas de leis (13.019/2014, 13.204/2015, Decreto Municipal 7172/2017). O edital anexado nao traz cronograma. inicio e fim ficam null. Para fechar, pedir o cronograma a Secretaria de Assistencia Social ou conferir a publicacao no orgao oficial do municipio."
 },
 "258be129fcecbe9530ba": {
