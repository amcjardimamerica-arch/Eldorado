 "ponte": {
  "escolha": "computador_do_titular",
  "como": "scripts/coleta_brasil.py roda no computador do titular com ELDORADO_LOCAL_BR=1 e lê os sites da rota 'ponte' (python -m src.indexadores rodada --rota ponte); agendado por scripts/agendar_coleta_brasil.ps1 a cada 3 horas, das 06:10 às 21:10, com o computador ligado",
  "na_nuvem": "o GitHub não lê os sites da rota 'ponte': marca a espera e deixa para a coleta no computador",
  "entrega": "o computador envia cada rodada como arquivo novo em entrada_manual/indexadores/deltas/; o fluxo 16 aplica sobre o main mais novo (aplicar --brasil) e apaga o arquivo",
  "dias_sem_leitura_para_navegador": 3,
  "alternativas_futuras": {
   "vm_brasil": "scripts/instalar_vm_brasil.sh (Oracle Always Free ou VM paga)",
